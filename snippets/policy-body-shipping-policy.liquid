{%- comment -%}
  Default Shipping Policy (design: Standard.dc), rendered by
  snippets/somna-policy-doc.liquid while the page body is empty. Uses the
  evenly spaced article layout (s-policy--flow, set by sections/main-page).
  part: 'toc' (On this page links) or 'body'.
{%- endcomment -%}
{%- if part == 'toc' -%}
  <a href="#processing">Processing times</a>
  <a href="#rates">Rates &amp; delivery</a>
  <a href="#international">International orders</a>
  <a href="#tracking">Tracking your order</a>
  <a href="#damaged">Damaged or missing items</a>
{%- else -%}
  {%- capture support_url -%}{%- render 'somna-policy-url', handle: 'support' -%}{%- endcapture -%}
  {%- capture track_url -%}{%- render 'somna-policy-url', handle: 'support', anchor: 'track' -%}{%- endcapture -%}
  <div class="s-callout">
    {%- render 'somna-icon', name: 'truck', size: 24 -%}
    <p><strong>Free standard shipping on orders over $[X]</strong> to the [contiguous US]. Your [100]-night trial starts the day your order is delivered.</p>
  </div>

  <h2 id="processing">Processing Times</h2>
  <p>Orders placed before [2pm ET] on a business day usually leave our warehouse within [1–2] business days. Orders placed on weekends or holidays are processed the next business day. During launches and sale events, processing can take up to [X] extra days; we'll email you if that happens.</p>

  <h2 id="rates">Rates &amp; Delivery</h2>
  <div class="s-table-box">
    <table class="s-table">
      <thead>
        <tr>
          <th scope="col">Method</th>
          <th scope="col">Delivery time</th>
          <th scope="col">Cost</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Standard</td><td>[3–7] business days</td><td>Free over $[X], else $[X]</td></tr>
        <tr><td>Express</td><td>[2–3] business days</td><td>$[X]</td></tr>
        <tr><td>Overnight</td><td>[1] business day</td><td>$[X]</td></tr>
        <tr><td>Alaska, Hawaii, PR</td><td>[5–10] business days</td><td>$[X]</td></tr>
      </tbody>
    </table>
  </div>
  <p class="s-pol-note">Comforters ship vacuum-packed in a compact box. Allow [24] hours after unboxing for full loft.</p>

  <h2 id="international">International Orders</h2>
  <p>We currently ship to [list of countries]. Duties and taxes are [calculated at checkout / paid on delivery]. International orders are eligible for the [100]-night trial; return shipping may apply.</p>
  <ul>
    <li>[Canada]: [5–10] business days</li>
    <li>[United Kingdom &amp; EU]: [7–14] business days</li>
    <li>[Australia &amp; New Zealand]: [7–14] business days</li>
  </ul>

  <h2 id="tracking">Tracking Your Order</h2>
  <p>You'll get a shipping confirmation with a tracking link as soon as your order leaves us. You can also look it up any time on our <a href="{{ track_url }}">order tracking page</a> with your order number and email.</p>

  <h2 id="damaged">Damaged or Missing Items</h2>
  <p>If your package arrives damaged or never shows up, contact us within [14] days of the expected delivery date. Send a photo of any damage and we'll send a replacement or a refund, whichever you prefer.</p>

  {%- render 'somna-policy-cta', title: 'Still have questions?', text: 'Our sleep team replies within [24 hours], 7 days a week.', label: 'Contact Support', url: support_url, large: true -%}
{%- endif -%}
