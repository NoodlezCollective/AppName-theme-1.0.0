{%- comment -%}
  Somna pill sort <select> ("Sort" label + native select, Collection design).
  {% render 'filter-sort', current: collection.sort_by, default_sort: collection.default_sort_by, catalog: false, id: 'x-sort' %}
  `data-sort-by` carries the Shopify `sort_by` value assets/collection.js
  navigates with (the collection default clears the parameter). Collections
  sorted manually by default get a leading "Featured" option; /collections/all
  (`catalog: true`) never does.
{%- endcomment -%}
{%- liquid
  assign id = id | default: 'sort-select'
  assign option_list = 'best-selling|Bestselling,created-descending|Newest,price-ascending|Price, low to high,price-descending|Price, high to low'
  assign option_list = option_list | replace: 'Price, low', 'Price{c} low' | replace: 'Price, high', 'Price{c} high'
  if catalog != true and default_sort == 'manual'
    assign option_list = 'manual|Featured,' | append: option_list
  endif
  assign options = option_list | split: ','
  assign current = current | default: default_sort
  if catalog and current == 'manual'
    assign current = 'best-selling'
  endif
-%}
<div class="sc-sort">
  <label class="sc-sort__label" for="{{ id }}">Sort</label>
  <select class="sc-sort__select" id="{{ id }}" name="sort_by" data-sort-select data-default="{{ default_sort }}">
    {%- for option in options -%}
      {%- assign parts = option | split: '|' -%}
      <option value="{{ parts[0] }}" data-sort-by="{{ parts[0] }}"{% if parts[0] == current %} selected{% endif %}>{{ parts[1] | replace: '{c}', ',' }}</option>
    {%- endfor -%}
  </select>
</div>
