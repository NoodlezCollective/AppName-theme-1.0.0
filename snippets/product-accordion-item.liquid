{%- comment -%}
  One native <details> accordion item (app/components/ui/Accordion.tsx).
  {% render 'product-accordion-item', title: 'Care', content: html, open: false %}
{%- endcomment -%}
<details class="accordion__item"{% if open %} open{% endif %}>
  <summary class="accordion__summary">
    <span class="accordion__title">{{ title }}</span>
    <span class="accordion__icon" aria-hidden="true">{% render 'icon', name: 'plus', size: 16, stroke_width: 2 %}</span>
  </summary>
  <div class="accordion__panel"><div class="prose">{{ content }}</div></div>
</details>
