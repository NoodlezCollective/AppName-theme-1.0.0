{%- comment -%}
  Somna image frame: the merchant's image cropped to the frame, otherwise the
  design's labelled photo placeholder (shot code + brief) so the layout reads
  exactly like the design canvas until photography is uploaded.
  {% render 'somna-media', image: section.settings.image, alt: '…', code: 'H-01 · Hero lifestyle', brief: '…', ratio: '5 / 4', radius: 28, class: '', icon: 'camera', dark: false, sizes: '100vw', loading: 'lazy', label: 'Photo placeholder H-01' %}
  ratio: CSS aspect-ratio, or blank to size with CSS (min-height on the class).
{%- endcomment -%}
{%- liquid
  assign radius = radius | default: 20
  assign icon = icon | default: 'camera'
  assign loading = loading | default: 'lazy'
  assign sizes = sizes | default: '(min-width: 64em) 50vw, 100vw'
  assign style = ''
  if ratio != blank
    assign style = 'aspect-ratio: ' | append: ratio | append: ';'
  endif
-%}
{%- if image != blank -%}
  <div class="s-media s-r-{{ radius }}{% if class %} {{ class }}{% endif %}" style="{{ style }}">
    {{ image | image_url: width: 2000 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600, 2000', sizes: sizes, loading: loading, alt: alt }}
  </div>
{%- else -%}
  {%- assign ph_label = label | default: code | default: 'Photo placeholder' -%}
  <div class="s-ph s-r-{{ radius }}{% if dark %} s-ph--dark{% endif %}{% if class %} {{ class }}{% endif %}" style="{{ style }}" role="img" aria-label="{{ ph_label | escape }}">
    {%- if icon != 'none' -%}{%- render 'somna-icon', name: icon, size: 32 -%}{%- endif -%}
    {%- if code != blank -%}<span class="s-ph__code">{{ code }}</span>{%- endif -%}
    {%- if brief != blank -%}<span class="s-ph__brief">{{ brief }}</span>{%- endif -%}
  </div>
{%- endif -%}
