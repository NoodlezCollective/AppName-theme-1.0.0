  part: 'toc' (On this page links) or 'body'.
{%- endcomment -%}
{%- if part == 'toc' -%}
  <a href="#methods">1. Accepted payment methods</a>
  <a href="#currency">2. Currency &amp; pricing</a>
  <a href="#charged">3. When you're charged</a>
