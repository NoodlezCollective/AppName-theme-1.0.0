{%- comment -%}
  Somna option pickers (Product design): one fieldset per option with a
  "Size: Queen" legend and pill buttons (round swatches for options with a
  native swatch, grouped under the labels of the `mellow.swatch_groups` JSON
  metafield). `mellow.size_guide` sits under the Size option; `hint_option` /
  `hint` add a note under the option of that name ("Side sleeper? …").
  Options with a single value are not shown.
  Hooks for assets/product.js: [data-option-index], [data-option-selected],
  [data-option-value] (snippets/product-option-value).
  {% render 'product-variant-selector', product: product, id_prefix: 'product-option', hint_option: 'Firmness', hint: '<p>…</p>' %}
{%- endcomment -%}
{%- liquid
  assign id_prefix = id_prefix | default: 'product-option'
  assign swatch_groups = product.metafields.mellow.swatch_groups.value
  assign size_guide = product.metafields.mellow.size_guide.value | strip
  assign hint_option = hint_option | strip | downcase
-%}
{%- for option in product.options_with_values -%}
  {%- if option.values.size < 2 -%}{%- continue -%}{%- endif -%}
  {%- liquid
    assign option_index = option.position | minus: 1
    assign is_swatch = false
    assign selected_name = ''
    for value in option.values
      if value.swatch.color != blank or value.swatch.image != blank
        assign is_swatch = true
      endif
      if value.selected
        assign selected_name = value.name
      endif
    endfor
    assign option_name_down = option.name | downcase
    assign values_class = 'sp-option__values'
    if is_swatch
      assign values_class = 'sp-option__values sp-option__values--swatches'
    endif
    assign groups_rendered = 0
    assign assigned = '|'
  -%}
  <fieldset class="sp-option" id="{{ id_prefix }}-{{ option_index }}" data-option-index="{{ option_index }}">
    <legend class="sp-option__legend">{{ option.name }}: <span class="sp-option__value" data-option-selected>{{ selected_name }}</span></legend>
    {%- if is_swatch and swatch_groups != blank -%}
      {%- for group in swatch_groups -%}
        {%- liquid
          assign group_label = group[0]
          assign names = group[1]
          if names.size == 0
            continue
          endif
          assign lookup = names | join: '|' | downcase | prepend: '|' | append: '|'
        -%}
        {%- capture group_values -%}
          {%- for value in option.values -%}
            {%- assign probe = value.name | strip | downcase | prepend: '|' | append: '|' -%}
            {%- if lookup contains probe -%}
              {%- assign assigned = assigned | append: value.name | append: '|' -%}
              {%- render 'product-option-value', value: value, is_swatch: is_swatch, product: product -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if group_values != blank -%}
          {%- assign groups_rendered = groups_rendered | plus: 1 -%}
          <div class="sp-option__group">
            <span class="sp-option__group-label">{{ group_label | escape }}</span>
            <div class="{{ values_class }}">{{ group_values }}</div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if groups_rendered > 0 -%}
      {%- capture rest_values -%}
        {%- for value in option.values -%}
          {%- assign probe = '|' | append: value.name | append: '|' -%}
          {%- unless assigned contains probe -%}
            {%- render 'product-option-value', value: value, is_swatch: is_swatch, product: product -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if rest_values != blank -%}
        <div class="sp-option__group">
          <span class="sp-option__group-label">{{ option.name }}</span>
          <div class="{{ values_class }}">{{ rest_values }}</div>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="{{ values_class }}">
        {%- for value in option.values -%}
          {%- render 'product-option-value', value: value, is_swatch: is_swatch, product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if size_guide != blank and option_name_down == 'size' -%}
      <span class="sp-option__hint">{{ size_guide | escape }}</span>
    {%- endif -%}
    {%- if hint != blank and hint_option != blank and option_name_down == hint_option -%}
      <div class="sp-option__hint">{{ hint }}</div>
    {%- endif -%}
  </fieldset>
{%- endfor -%}
