{%- comment -%}
  Somna product gallery (Product design): one square frame with the badge,
  then a six-column thumbnail grid. Slides are every product media item
  (images, Shopify videos, YouTube/Vimeo); the selected variant's media is
  the active slide. assets/product.js drives the thumbnails, variant changes
  and the mobile scroll-snap strip. Without media: the design's labelled
  placeholder.
  {% render 'product-gallery', product: product, badge: 'Bestseller' %}
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign count = product.media.size
  assign active_index = 0
  if current.featured_media
    for media in product.media
      if media.id == current.featured_media.id
        assign active_index = forloop.index0
      endif
    endfor
  endif
  assign label = product.title | append: ' media'
  assign sizes = '(min-width: 75em) 620px, (min-width: 64em) 52vw, 100vw'
-%}
<div class="sp-gallery" data-gallery>
  <div class="sp-gallery__main">
    {%- if badge != blank -%}<span class="s-badge sp-gallery__badge">{{ badge }}</span>{%- endif -%}
    {%- if count == 0 -%}
      <div class="sp-gallery__ph" role="img" aria-label="Media placeholder P-01">
        {%- render 'somna-icon', name: 'camera', size: 34 -%}
        <span class="s-ph__code">P-01 · Packshot</span>
        <span class="sp-gallery__ph-brief">{{ product.title }}</span>
      </div>
    {%- else -%}
      <div class="sp-gallery__track" role="group" aria-label="{{ label | escape }}" tabindex="0" data-gallery-track>
        {%- for media in product.media -%}
          {%- liquid
            assign index = forloop.index0
            assign alt = media.alt | default: product.title
            assign loading = 'lazy'
            assign fetchpriority = 'auto'
            if index == active_index
              assign loading = 'eager'
              assign fetchpriority = 'high'
            endif
          -%}
          <div class="sp-gallery__slide{% if index == active_index %} is-active{% endif %}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ count }}" data-gallery-slide data-media-id="{{ media.id }}">
            {%- case media.media_type -%}
              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1200x', controls: true, muted: true, loop: true, playsinline: true, preload: 'metadata' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: loading: 'lazy' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: sizes, loading: loading, fetchpriority: fetchpriority, alt: alt }}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
  {%- if count > 1 -%}
    <div class="sp-gallery__thumbs" role="group" aria-label="Product media" data-gallery-thumbs>
      {%- for media in product.media -%}
        <button type="button" class="sp-gallery__thumb{% if forloop.index0 == active_index %} is-active{% endif %}" aria-pressed="{% if forloop.index0 == active_index %}true{% else %}false{% endif %}" aria-label="Show media {{ forloop.index }} of {{ count }}" data-gallery-thumb>
          {%- if media.preview_image -%}
            {{ media.preview_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: loading: 'lazy', alt: '', width: 120, height: 120 }}
          {%- else -%}
            <span>{{ forloop.index }}</span>
          {%- endif -%}
          {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
            <span class="sp-gallery__thumb-play" aria-hidden="true">{%- render 'somna-icon', name: 'play', size: 14 -%}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
