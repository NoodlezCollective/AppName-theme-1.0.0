{%- comment -%}
  One help-center question (sections/somna-support-help.liquid).
  {% render 'somna-support-faq', block: block, open: true %}
{%- endcomment -%}
<details class="s-faq__item" data-somna-faq{% if open %} open{% endif %} {{ block.shopify_attributes }}>
  <summary class="s-faq__q">{{ block.settings.question | replace: '{AppName}', settings.brand_name | escape }}<span class="s-faq__icon" aria-hidden="true"></span></summary>
  <div class="s-faq__a">{{ block.settings.answer | replace: '{AppName}', settings.brand_name }}</div>
</details>
