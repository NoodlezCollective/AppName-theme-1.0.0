{%- comment -%}
  One cart line (Header.dc.html cart drawer): 84px image, name + line price,
  variant, pill quantity stepper and "Remove".
  {% render 'cart-line', line: line, index: forloop.index, layout: 'aside' | 'page' %}
  The forms work without JavaScript (POST routes.cart_change_url with the
  line key and quantity); assets/theme.js intercepts them through
  data-cart-line-form / data-cart-line-action and re-renders the cart.
  Keep the .cart-line > .cart-line__body .cart-line__remove structure:
  theme.js moves focus with it after a removal.
{%- endcomment -%}
{%- liquid
  assign layout = layout | default: 'aside'
  assign quantity = line.quantity
  assign prev_quantity = quantity | minus: 1 | at_least: 0
  assign next_quantity = quantity | plus: 1
  assign line_url = line.url | default: line.product.url
  assign variant_text = ''
  for option in line.options_with_values
    if option.value == 'Default Title'
      continue
    endif
    if variant_text == ''
      assign variant_text = option.value
    else
      assign variant_text = variant_text | append: ' · ' | append: option.value
    endif
  endfor
  if line.selling_plan_allocation
    if variant_text == ''
      assign variant_text = line.selling_plan_allocation.selling_plan.name
    else
      assign variant_text = variant_text | append: ' · ' | append: line.selling_plan_allocation.selling_plan.name
    endif
  endif
  assign line_title = line.product.title | default: line.title
  assign image_alt = line.image.alt | default: line_title
-%}
<li class="cart-line sc-line" data-cart-line="{{ line.key }}" data-line-index="{{ index }}" data-line-quantity="{{ quantity }}">
  <a class="sc-line__media" tabindex="-1" aria-hidden="true" href="{{ line_url }}">
    {%- if line.image -%}
      {{ line.image | image_url: width: 240, height: 240, crop: 'center' | image_tag: widths: '84, 168, 240', sizes: '84px', loading: 'lazy', alt: image_alt }}
    {%- else -%}
      P-{{ index | prepend: '0' | slice: -2, 2 }}
    {%- endif -%}
  </a>
  <div class="cart-line__body">
    <div class="sc-line__top">
      <a class="sc-line__name" href="{{ line_url }}">{{ line_title }}</a>
      <span class="sc-line__price">
        {{- line.final_line_price | money -}}
        {%- if line.original_line_price > line.final_line_price -%}
          <s class="sc-line__was"><span class="s-sr">Regular price </span>{{ line.original_line_price | money }}</s>
        {%- endif -%}
      </span>
    </div>
    {%- if variant_text != blank -%}<span class="sc-line__variant">{{ variant_text }}</span>{%- endif -%}
    {%- for property in line.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last == blank or first_char == '_' -%}{%- continue -%}{%- endif -%}
      <p class="sc-line__props">{{ property.first }}: {{ property.last }}</p>
    {%- endfor -%}
    <div class="sc-line__actions">
      <div class="sc-qty" role="group" aria-label="Quantity for {{ line_title | escape }}">
        <form method="post" action="{{ routes.cart_change_url }}" data-cart-line-form>
          <input type="hidden" name="id" value="{{ line.key }}">
          <input type="hidden" name="quantity" value="{{ prev_quantity }}">
          <button aria-label="Decrease quantity"{% if quantity <= 1 %} aria-disabled="true"{% endif %} class="sc-qty__btn" name="decrease-quantity" type="submit" value="{{ prev_quantity }}" data-cart-line-action="decrease">−</button>
        </form>
        <span class="sc-qty__value" aria-live="polite" data-cart-line-quantity><span class="s-sr">Quantity </span>{{ quantity }}</span>
        <form method="post" action="{{ routes.cart_change_url }}" data-cart-line-form>
          <input type="hidden" name="id" value="{{ line.key }}">
          <input type="hidden" name="quantity" value="{{ next_quantity }}">
          <button aria-label="Increase quantity" class="sc-qty__btn" name="increase-quantity" type="submit" value="{{ next_quantity }}" data-cart-line-action="increase">+</button>
        </form>
      </div>
      <form method="post" action="{{ routes.cart_change_url }}" data-cart-line-form>
        <input type="hidden" name="id" value="{{ line.key }}">
        <input type="hidden" name="quantity" value="0">
        <button aria-label="Remove {{ line_title | escape }}" class="sc-line__remove cart-line__remove" type="submit" data-cart-line-action="remove">Remove</button>
      </form>
    </div>
  </div>
</li>
