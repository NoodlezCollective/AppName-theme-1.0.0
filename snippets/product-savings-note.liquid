{%- comment -%}
  "Savings based on comparable value. Learn more" disclosure
  (app/components/product/SavingsNote.tsx). `mellow.savings_note` overrides
  the note from settings; the explanation comes from settings. Shown only
  while the selected variant is on sale (product.js toggles `hidden`).
  {% render 'product-savings-note', product: product, on_sale: true, id: 'savings-note-panel' %}
{%- endcomment -%}
{%- liquid
  assign id = id | default: 'savings-note-panel'
  assign note = product.metafields.mellow.savings_note.value | strip
  if note == blank
    assign note = settings.savings_note | default: 'Savings based on comparable value.'
  endif
  assign explanation = settings.savings_explanation | default: 'Compare-at prices reflect the comparable retail value of similar bedding sold at full price. Your savings are the difference between that value and the {AppName} price.'
  assign explanation = explanation | replace: '{AppName}', settings.brand_name
  assign note = note | replace: '{AppName}', settings.brand_name
-%}
<div class="savings-note" data-savings-note{% unless on_sale %} hidden{% endunless %}>
  <p class="savings-note__text">{{ note | escape }} <button type="button" class="savings-note__toggle" aria-expanded="false" aria-controls="{{ id }}" data-savings-toggle>Learn more</button></p>
  <div id="{{ id }}" class="savings-note__panel" role="note" hidden data-savings-panel><p>{{ explanation | escape }}</p></div>
</div>
