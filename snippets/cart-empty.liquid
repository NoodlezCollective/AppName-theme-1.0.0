{%- assign brand_token = '{AppName}' -%}
{%- comment -%}
  Empty cart (Header.dc.html cart drawer): moon badge, heading, free-gift
  reminder and "Shop Bestsellers". Copy lives in Theme settings > Cart;
  {gift} and {threshold} in the text are replaced with the cart reward.
  {% render 'cart-empty', layout: 'aside' | 'page' %}
  theme.js focuses .cart__empty .empty-state__title after the last removal.
{%- endcomment -%}
{%- liquid
  assign layout = layout | default: 'aside'
  assign brand = settings.brand_name | default: 'Somna'
  assign threshold = settings.free_gift_threshold | default: 0 | times: 100
  assign threshold_text = threshold | money_without_trailing_zeros
  assign empty_text = settings.cart_empty_text | replace: brand_token, brand | replace: '{gift}', settings.free_gift_label | replace: '{threshold}', threshold_text
  assign empty_url = settings.cart_empty_url | default: routes.all_products_collection_url
  if layout == 'page'
    assign heading_tag = 'h2'
  else
    assign heading_tag = 'h3'
  endif
-%}
<div class="cart__empty sc-empty">
  <span class="sc-empty__icon" aria-hidden="true">{% render 'somna-icon', name: 'moon', size: 30 %}</span>
  <{{ heading_tag }} class="empty-state__title sc-empty__title" tabindex="-1">{{ settings.cart_empty_heading | default: 'Your sleep stack is empty' | replace: brand_token, brand }}</{{ heading_tag }}>
  {%- if empty_text != blank -%}<p class="sc-empty__text">{{ empty_text }}</p>{%- endif -%}
  <a class="sc-empty__cta" href="{{ empty_url }}">{{ settings.cart_empty_button | default: 'Shop Bestsellers' }}</a>
</div>
