{%- comment -%}
  Somna pill quantity stepper (Product design: − 1 +). The input belongs to
  the add-to-cart form through its `form` attribute, so a plain form post
  carries the quantity. The buttons are aria-disabled at the bounds instead
  of disabled so they keep focus (assets/product.js).
  {% render 'product-quantity', value: 1, id: 'product-quantity', form_id: 'product-form' %}
{%- endcomment -%}
{%- liquid
  assign value = value | default: 1
  assign id = id | default: 'product-quantity'
-%}
<div class="sp-qty" role="group" aria-label="Quantity" data-quantity>
  <label class="s-sr" for="{{ id }}">Quantity</label>
  <button type="button" class="sp-qty__btn" aria-label="Decrease quantity"{% if value <= 1 %} aria-disabled="true"{% endif %} data-quantity-decrease>−</button>
  <input id="{{ id }}" class="sp-qty__input" type="number" inputmode="numeric" min="1" max="99" step="1" value="{{ value }}" name="quantity"{% if form_id %} form="{{ form_id }}"{% endif %} data-quantity-input>
  <button type="button" class="sp-qty__btn" aria-label="Increase quantity" data-quantity-increase>+</button>
</div>
