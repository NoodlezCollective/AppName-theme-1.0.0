{%- comment -%}
  "30-Day Trial · Hassle-Free Returns" row from settings.trust_badges, one
  "icon|Label" per line (app/components/product/TrustBadges.tsx). Falls back
  to the storefront defaults when the setting has no usable line.
  {% render 'product-trust-badges' %}
{%- endcomment -%}
{%- liquid
  assign lines = settings.trust_badges | newline_to_br | split: '<br />'
  assign badges = ''
  for line in lines
    assign clean = line | strip
    if clean != blank
      assign badges = badges | append: clean | append: '<br />'
    endif
  endfor
  if badges == blank
    assign badges = 'shield|30-Day Trial<br />truck|Hassle-Free Returns'
  endif
  assign items = badges | split: '<br />'
-%}
{%- render 'product-icon-list', items: items, class: 'trust-badges product-trust', label: 'Guarantees', size: 20, defaults: 'shield,truck' -%}
