{%- comment -%}
  Somna bestsellers (design: Main / BESTSELLERS). Shows the chosen collection;
  while it is unset or empty, the product blocks render instead (each with its
  own product, or the design's placeholder card until one is picked).
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign eyebrow = section.settings.eyebrow | replace: '{AppName}', brand
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign link_label = section.settings.link_label | replace: '{AppName}', brand
  assign collection = section.settings.collection
  assign link_url = section.settings.link_url
  if link_url == blank
    if collection != blank
      assign link_url = collection.url
    else
      assign link_url = routes.all_products_collection_url
    endif
  endif
  assign use_collection = false
  if collection != blank and collection.products_count > 0
    assign use_collection = true
  endif
-%}
<section class="sh{% if section.settings.hide_mobile %} sh-hide-mobile{% endif %} s-section" aria-labelledby="SomnaProductsTitle-{{ section.id }}">
  <div class="s-wrap sh-stack-40">
    <div class="s-head-row">
      <div class="s-head">
        {%- if eyebrow != blank -%}<span class="s-eyebrow">{{ eyebrow }}</span>{%- endif -%}
        <h2 id="SomnaProductsTitle-{{ section.id }}" class="s-h2 s-balance">{{ heading }}</h2>
      </div>
      {%- if link_label != blank -%}
        <a class="s-link-arrow sh-products__all" href="{{ link_url }}">{{ link_label }} {% render 'somna-icon', name: 'arrow-right', size: 18 %}</a>
      {%- endif -%}
    </div>
    <div class="s-grid s-grid--products sh-swipe" data-sh-swipe>
      {%- if use_collection -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'somna-product-card', product: product, actions: 'shop', cta_label: section.settings.cta_label -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }} style="display: contents;">
            {%- if block.settings.product != blank -%}
              {%- render 'somna-product-card', product: block.settings.product, actions: 'shop', cta_label: section.settings.cta_label -%}
            {%- else -%}
              {%- render 'somna-product-card',
                product: nil,
                actions: 'shop',
                cta_label: section.settings.cta_label,
                name: block.settings.name,
                line: block.settings.line,
                badge: block.settings.badge,
                shot: block.settings.shot_code,
                brief: block.settings.shot_brief,
                url: link_url
              -%}
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Somna bestsellers",
  "max_blocks": 12,
  "settings": [
    {"type": "checkbox", "id": "hide_mobile", "label": "Hide on mobile", "default": false, "info": "Hides this section on screens narrower than 750px."},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our most loved"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Explore Our Most Loved Sleep Products"},
    {"type": "text", "id": "link_label", "label": "Link label", "default": "Shop All"},
    {"type": "url", "id": "link_url", "label": "Link", "info": "Blank links to the collection (or all products)."},
    {"type": "collection", "id": "collection", "label": "Collection", "info": "While unset or empty, the product blocks below are shown."},
    {"type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4},
    {"type": "text", "id": "cta_label", "label": "Card button label", "default": "Shop Now"}
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {"type": "product", "id": "product", "label": "Product"},
        {"type": "paragraph", "content": "Used until a product is picked:"},
        {"type": "text", "id": "name", "label": "Placeholder name", "default": "CloudAlign Pillow"},
        {"type": "text", "id": "line", "label": "Placeholder one-liner", "default": "Contoured support that keeps your neck aligned all night."},
        {"type": "text", "id": "badge", "label": "Placeholder badge", "default": "Bestseller"},
        {"type": "text", "id": "shot_code", "label": "Placeholder shot code", "default": "P-01"},
        {"type": "text", "id": "shot_brief", "label": "Placeholder brief", "default": "CloudAlign Pillow, 3/4 angle on lavender sweep"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Somna bestsellers",
      "blocks": [
        {"type": "product", "settings": {"name": "CloudAlign Pillow", "line": "Contoured support that keeps your neck aligned all night.", "badge": "Bestseller", "shot_code": "P-01", "shot_brief": "CloudAlign Pillow, 3/4 angle on lavender sweep"}},
        {"type": "product", "settings": {"name": "CloudCool Cooling Comforter", "line": "Breathable, cool-to-touch comfort for hot sleepers.", "badge": "New colors", "shot_code": "P-02", "shot_brief": "CloudCool Comforter, folded stack, fabric detail visible"}},
        {"type": "product", "settings": {"name": "MarshMellow Comforter", "line": "Marshmallow-soft loft for cosy, all-season sleep.", "badge": "Most loved", "shot_code": "P-03", "shot_brief": "MarshMellow Comforter, loose drape showing loft"}},
        {"type": "product", "settings": {"name": "CloudControl Comforter", "line": "Dual-sided warmth you can flip as the seasons change.", "badge": "New", "shot_code": "P-04", "shot_brief": "CloudControl Comforter, corner flipped to show both sides"}}
      ]
    }
  ]
}
{% endschema %}
