{%- comment -%}
  Image pair under the video grid (app/components/home/LifestyleGallery.tsx).
  Only the first two images are shown.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name
  assign label = section.settings.label | replace: '{AppName}', brand
-%}
{%- if section.blocks.size > 0 -%}
  <section class="section section--tight" aria-label="{{ label | escape }}">
    <div class="container lifestyle-grid">
      {%- for block in section.blocks limit: 2 -%}
        {%- liquid
          assign image = block.settings.image
          assign alt = image.alt | default: block.settings.alt | replace: '{AppName}', brand
          assign caption = block.settings.caption | replace: '{AppName}', brand
          assign placeholder = 'placeholder-lifestyle-' | append: forloop.index | append: '.svg'
        -%}
        <figure {{ block.shopify_attributes }}>
          {%- if image != blank -%}
            {%- render 'image', image: image, alt: alt, sizes: '(min-width: 48em) 50vw, 100vw' -%}
          {%- else -%}
            {%- render 'image', placeholder: placeholder, alt: alt, width: 1376, height: 760 -%}
          {%- endif -%}
          {%- if caption != blank -%}<figcaption>{{ caption }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lifestyle gallery",
  "max_blocks": 2,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Life with {AppName}"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Placeholder artwork is used until one is chosen."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "info": "Used when the image has no alt text of its own."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle gallery",
      "blocks": [
        {"type": "image", "settings": {"alt": "Woman smiling while resting on a stack of {AppName} pillows"}},
        {"type": "image", "settings": {"alt": "Close-up of the MarshMellow comforter fabric"}}
      ]
    }
  ]
}
{% endschema %}
