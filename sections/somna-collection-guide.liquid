{%- comment -%}
  "Which Comforter Is Right for You?" guide (Collection design): eyebrow,
  heading and cards with a five-step warmth meter. Each card links to a
  product, or to its link setting.
{%- endcomment -%}
{%- assign brand = settings.brand_name -%}
{{ 'somna-collection.css' | asset_url | stylesheet_tag }}
<section class="sc-guide">
  <div class="sc-guide__inner">
    <div class="sc-guide__head">
      {%- if section.settings.eyebrow != blank -%}<span class="s-eyebrow">{{ section.settings.eyebrow | replace: '{AppName}', brand }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="s-h2">{{ section.settings.heading | replace: '{AppName}', brand }}</h2>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="sc-guide__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign card_product = block.settings.product
            assign name = block.settings.title | replace: '{AppName}', brand
            if name == blank and card_product != blank
              assign name = card_product.title
            endif
            assign href = block.settings.link
            if card_product != blank
              assign href = card_product.url
            endif
            assign href = href | default: routes.all_products_collection_url
            assign link_label = block.settings.link_label | replace: '{AppName}', brand
            if link_label == blank
              assign link_label = 'Shop ' | append: name
            endif
            assign warmth = block.settings.warmth
          -%}
          <div class="sc-guide__card" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}<span class="s-eyebrow">{{ block.settings.eyebrow | replace: '{AppName}', brand }}</span>{%- endif -%}
            <h3 class="sc-guide__name">{{ name }}</h3>
            <div class="sc-guide__warmth">
              <span class="sc-guide__warmth-label">{{ section.settings.warmth_label }}</span>
              <div class="sc-guide__dots" role="img" aria-label="{{ section.settings.warmth_label | escape }} {{ warmth }} of 5">
                {%- for i in (1..5) -%}<span class="sc-guide__dot{% if i <= warmth %} is-on{% endif %}"></span>{%- endfor -%}
              </div>
            </div>
            {%- if block.settings.body != blank -%}<p class="sc-guide__body">{{ block.settings.body | replace: '{AppName}', brand }}</p>{%- endif -%}
            <a class="sc-guide__link" href="{{ href }}">{{ link_label }}</a>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Comforter guide",
  "tag": "div",
  "class": "section-somna-collection-guide",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Comforter guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Which Comforter Is Right for You?"
    },
    {
      "type": "text",
      "id": "warmth_label",
      "label": "Meter label",
      "default": "Warmth"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Guide card",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Best for hot sleepers"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "CloudCool Comforter",
          "info": "Leave blank to use the product's title."
        },
        {
          "type": "range",
          "id": "warmth",
          "label": "Warmth",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Text",
          "default": "Lightweight and breathable. Ideal if you wake up warm or live somewhere humid."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used when no product is picked."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Defaults to \"Shop\" + the name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Comforter guide",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "eyebrow": "Best for hot sleepers",
            "title": "CloudCool Comforter",
            "warmth": 2,
            "body": "Lightweight and breathable. Ideal if you wake up warm or live somewhere humid."
          }
        },
        {
          "type": "card",
          "settings": {
            "eyebrow": "Best for cosy sleepers",
            "title": "MarshMellow Comforter",
            "warmth": 4,
            "body": "Lofty, plush and cocooning. The one for people who love to sink in."
          }
        },
        {
          "type": "card",
          "settings": {
            "eyebrow": "Best for couples",
            "title": "CloudControl Comforter",
            "warmth": 3,
            "body": "Two sides, two feels. Flip it as the seasons, or your partner, change."
          }
        }
      ]
    }
  ]
}
{% endschema %}
