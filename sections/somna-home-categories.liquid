{%- comment -%}
  Somna categories (design: Main / CATEGORIES). Three 4:5 cards; each block
  links to its collection (or a custom link) and shows its image, else the
  collection image, else the design's labelled placeholder.
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign eyebrow = section.settings.eyebrow | replace: '{AppName}', brand
  assign heading = section.settings.heading | replace: '{AppName}', brand
-%}
<section class="sh s-section" aria-labelledby="SomnaCatsTitle-{{ section.id }}">
  <div class="s-wrap sh-stack-40">
    <div class="sh-head-center">
      {%- if eyebrow != blank -%}<span class="s-eyebrow">{{ eyebrow }}</span>{%- endif -%}
      <h2 id="SomnaCatsTitle-{{ section.id }}" class="s-h2">{{ heading }}</h2>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="sh-cats__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign title = block.settings.title | default: c.title | replace: '{AppName}', brand
            assign sub = block.settings.subtitle | replace: '{AppName}', brand
            assign url = block.settings.link | default: c.url | default: routes.all_products_collection_url
            assign image = block.settings.image | default: c.featured_image
            assign alt = image.alt | default: title
            assign ph_label = 'Photo placeholder ' | append: block.settings.shot_code
          -%}
          <a class="sh-cat" href="{{ url }}" {{ block.shopify_attributes }}>
            {%- render 'somna-media',
              image: image,
              alt: alt,
              code: block.settings.shot_code,
              brief: block.settings.shot_brief,
              label: ph_label,
              ratio: '4 / 5',
              radius: 28,
              class: 'sh-ph-sm',
              sizes: '(min-width: 1400px) 450px, (min-width: 990px) 33vw, 100vw'
            -%}
            <div class="sh-cat__row">
              <div class="sh-cat__text">
                <h3 class="s-h3">{{ title }}</h3>
                {%- if sub != blank -%}<span class="sh-cat__sub">{{ sub }}</span>{%- endif -%}
              </div>
              <span class="sh-cat__arrow" aria-hidden="true">{%- render 'somna-icon', name: 'arrow-right', size: 20 -%}</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Somna categories",
  "max_blocks": 6,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Build Your Sleep Stack"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type": "collection", "id": "collection", "label": "Collection"},
        {"type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link."},
        {"type": "text", "id": "title", "label": "Title", "default": "Pillows That Align", "info": "Blank uses the collection title."},
        {"type": "text", "id": "subtitle", "label": "Subtitle", "default": "For side, back and stomach sleepers"},
        {"type": "image_picker", "id": "image", "label": "Image", "info": "4:5. Falls back to the collection image, then the placeholder."},
        {"type": "text", "id": "shot_code", "label": "Placeholder shot code", "default": "C-01"},
        {"type": "textarea", "id": "shot_brief", "label": "Placeholder brief", "default": "Hand pressing into CloudAlign Pillow, slow rebound"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Somna categories",
      "blocks": [
        {"type": "category", "settings": {"title": "Pillows That Align", "subtitle": "For side, back and stomach sleepers", "shot_code": "C-01", "shot_brief": "Hand pressing into CloudAlign Pillow, slow rebound"}},
        {"type": "category", "settings": {"title": "Comforters That Adapt", "subtitle": "Cooling, all-season and dual-sided", "shot_code": "C-02", "shot_brief": "Made bed with comforter, sunset light across it"}},
        {"type": "category", "settings": {"title": "Bundles That Save", "subtitle": "Pair up and save up to [X]%", "shot_code": "C-03", "shot_brief": "Pillow 2-pack + comforter styled as a full bed set"}}
      ]
    }
  ]
}
{% endschema %}
