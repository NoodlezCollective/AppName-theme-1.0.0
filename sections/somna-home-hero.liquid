{%- comment -%}
  Somna homepage hero (design: Main / HERO). Rating pill, headline, subline,
  two buttons, trust items (blocks), 5:4 image with a floating review card.
  Copy may contain {AppName}, replaced by the brand name theme setting.
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign rating_label = section.settings.rating_label | default: settings.rating_label | replace: '{AppName}', brand
  assign rating_aria = section.settings.rating_aria | replace: '{AppName}', brand
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign subheading = section.settings.subheading | replace: '{AppName}', brand
  assign primary_label = section.settings.primary_label | replace: '{AppName}', brand
  assign primary_url = section.settings.primary_url | default: routes.all_products_collection_url
  assign secondary_label = section.settings.secondary_label | replace: '{AppName}', brand
  assign secondary_url = section.settings.secondary_url | default: '#quiz'
  assign image = section.settings.image
  assign image_alt = image.alt | default: section.settings.image_alt | replace: '{AppName}', brand
  assign review_quote = section.settings.review_quote | replace: '{AppName}', brand
  assign review_name = section.settings.review_name | replace: '{AppName}', brand
  assign review_verified = section.settings.review_verified | replace: '{AppName}', brand
-%}
<section class="sh sh-hero" aria-labelledby="SomnaHeroTitle-{{ section.id }}">
  <div class="sh-inner sh-hero__inner">
    <div class="sh-hero__copy">
      {%- if rating_label != blank -%}
        <div class="sh-hero__rating">
          {%- render 'somna-stars', size: 16, label: rating_aria -%}
          <strong>{{ rating_label }}</strong>
        </div>
      {%- endif -%}
      <h1 id="SomnaHeroTitle-{{ section.id }}" class="sh-hero__title">{{ heading }}</h1>
      {%- if subheading != blank -%}<p class="sh-hero__sub">{{ subheading }}</p>{%- endif -%}
      {%- if primary_label != blank or secondary_label != blank -%}
        <div class="sh-hero__ctas">
          {%- if primary_label != blank -%}<a class="s-btn s-btn--lg" href="{{ primary_url }}">{{ primary_label }}</a>{%- endif -%}
          {%- if secondary_label != blank -%}<a class="s-btn s-btn--lg s-btn--lavender sh-btn-px32" href="{{ secondary_url }}">{{ secondary_label }}</a>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="sh-hero__trust">
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'somna-icon', name: block.settings.icon, size: 20 -%}
              {{- block.settings.text | replace: '{AppName}', brand -}}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="sh-hero__media">
      {%- render 'somna-media',
        image: image,
        alt: image_alt,
        code: section.settings.shot_code,
        brief: section.settings.shot_brief,
        label: section.settings.placeholder_label,
        ratio: '5 / 4',
        radius: 28,
        loading: 'eager',
        sizes: '(min-width: 1400px) 700px, (min-width: 990px) 50vw, 100vw'
      -%}
      {%- if section.settings.show_review and review_quote != blank -%}
        <div class="sh-hero__review">
          {%- render 'somna-stars', size: 14, label: 'Rated 5 out of 5' -%}
          <p>{{ review_quote }}</p>
          <span class="sh-hero__review-by">{{ review_name }}{% if review_verified != blank %} <span class="s-verified">{{ review_verified }}</span>{% endif %}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Somna hero",
  "max_blocks": 6,
  "settings": [
    {"type": "header", "content": "Rating"},
    {"type": "text", "id": "rating_label", "label": "Rating label", "default": "[X]+ Happy Sleepers", "info": "Blank uses the Rating label theme setting."},
    {"type": "text", "id": "rating_aria", "label": "Rating description for screen readers", "default": "Rated [4.8] out of 5"},
    {"type": "header", "content": "Text"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Sleep Cooler. Wake Softer. Cloud-Like Comfort for Every Kind of Sleeper."},
    {"type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pillows that align and comforters that adapt, designed around the way you actually sleep. Try any of them for [100] nights."},
    {"type": "header", "content": "Buttons"},
    {"type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop Bestsellers"},
    {"type": "url", "id": "primary_url", "label": "Primary button link", "default": "/collections/all"},
    {"type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Find My Match"},
    {"type": "url", "id": "secondary_url", "label": "Secondary button link", "info": "Blank scrolls to the sleep quiz section (#quiz)."},
    {"type": "header", "content": "Image"},
    {"type": "image_picker", "id": "image", "label": "Image", "info": "5:4. Until one is chosen the design's labelled placeholder shows."},
    {"type": "text", "id": "image_alt", "label": "Image alt text", "default": "Woman asleep on a {AppName} pillow under a {AppName} comforter"},
    {"type": "text", "id": "shot_code", "label": "Placeholder shot code", "default": "H-01 · Hero lifestyle"},
    {"type": "textarea", "id": "shot_brief", "label": "Placeholder brief", "default": "Woman asleep on CloudAlign Pillow under the CloudCool Comforter, warm sunset light through sheer curtains, lavender bedding"},
    {"type": "text", "id": "placeholder_label", "label": "Placeholder label for screen readers", "default": "Photo placeholder H-01"},
    {"type": "header", "content": "Review card"},
    {"type": "checkbox", "id": "show_review", "label": "Show review card", "default": true},
    {"type": "textarea", "id": "review_quote", "label": "Review", "default": "\"[Short verified review about sleeping cooler, from your review app]\""},
    {"type": "text", "id": "review_name", "label": "Reviewer", "default": "[Reviewer name]"},
    {"type": "text", "id": "review_verified", "label": "Verified label", "default": "✓ Verified Buyer"}
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {"value": "truck", "label": "Truck"},
            {"value": "moon", "label": "Moon"},
            {"value": "shield-check", "label": "Shield with check"},
            {"value": "shield", "label": "Shield"},
            {"value": "gift", "label": "Gift"},
            {"value": "check", "label": "Check"},
            {"value": "star", "label": "Star"},
            {"value": "snowflake", "label": "Snowflake"},
            {"value": "leaf", "label": "Leaf"},
            {"value": "drop", "label": "Drop"},
            {"value": "soft", "label": "Feather"},
            {"value": "lock", "label": "Lock"}
          ]
        },
        {"type": "text", "id": "text", "label": "Text", "default": "Free shipping over $[X]"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Somna hero",
      "blocks": [
        {"type": "trust", "settings": {"icon": "truck", "text": "Free shipping over $[X]"}},
        {"type": "trust", "settings": {"icon": "moon", "text": "[100]-night trial"}},
        {"type": "trust", "settings": {"icon": "shield-check", "text": "[Lifetime] warranty"}}
      ]
    }
  ]
}
{% endschema %}
