{%- comment -%}
  Somna homepage hero. Desktop and tablet: full-width photo with the copy on
  a soft left-hand fade (photo subject on the right). Phones: photo first
  (separate portrait image), then rating, headline, one full-width button,
  the secondary action as a text link and a one-line trust row. Focal points
  set on the images in Shopify (Content › Files) control the crop.
  Copy may contain {AppName}, replaced by the brand name theme setting.
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign rating_label_template = section.settings.rating_label | default: settings.rating_label
  capture rating_label
    render 'somna-review-summary', part: 'label', label: rating_label_template
  endcapture
  assign rating_label = rating_label | strip
  capture store_rating
    render 'somna-review-summary', part: 'rating'
  endcapture
  assign store_rating = store_rating | strip
  assign rating_aria = section.settings.rating_aria | replace: '{AppName}', brand
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign mobile_heading = section.settings.mobile_heading | replace: '{AppName}', brand | strip
  assign subheading = section.settings.subheading | replace: '{AppName}', brand
  assign mobile_subheading = section.settings.mobile_subheading | replace: '{AppName}', brand | strip
  assign primary_label = section.settings.primary_label | replace: '{AppName}', brand
  assign primary_url = section.settings.primary_url | default: routes.all_products_collection_url
  assign secondary_label = section.settings.secondary_label | replace: '{AppName}', brand
  assign secondary_url = section.settings.secondary_url | default: '#quiz'
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile
  assign focal = '70% 50%'
  if image.presentation.focal_point != blank
    assign focal = image.presentation.focal_point
  endif
  assign focal_mobile = '50% 40%'
  if image_mobile.presentation.focal_point != blank
    assign focal_mobile = image_mobile.presentation.focal_point
  elsif image_mobile == blank and image.presentation.focal_point != blank
    assign focal_mobile = image.presentation.focal_point
  endif
  assign image_alt = image.alt | default: section.settings.image_alt | replace: '{AppName}', brand
  assign review_quote = section.settings.review_quote | replace: '{AppName}', brand
  assign review_name = section.settings.review_name | replace: '{AppName}', brand
  assign review_verified = section.settings.review_verified | replace: '{AppName}', brand
-%}
<section class="sh{% if section.settings.hide_mobile %} sh-hide-mobile{% endif %} sh-hero{% if image == blank and image_mobile == blank %} sh-hero--placeholder{% endif %}" aria-labelledby="SomnaHeroTitle-{{ section.id }}" style="--sh-hero-pos: {{ focal }}; --sh-hero-pos-m: {{ focal_mobile }};">
  <div class="sh-hero__media">
    {%- if image != blank or image_mobile != blank -%}
      {%- assign main_image = image | default: image_mobile -%}
      <picture>
        {%- if image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 600 }} 600w, {{ image_mobile | image_url: width: 900 }} 900w, {{ image_mobile | image_url: width: 1200 }} 1200w, {{ image_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
        {%- endif -%}
        {{ main_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'sh-hero__img', alt: image_alt }}
      </picture>
    {%- else -%}
      {%- render 'somna-media',
        code: section.settings.shot_code,
        brief: section.settings.shot_brief,
        label: section.settings.placeholder_label,
        radius: 0,
        class: 'sh-hero__ph'
      -%}
    {%- endif -%}
    {%- if section.settings.show_review and review_quote != blank -%}
      <div class="sh-hero__review">
        {%- render 'somna-stars', size: 14, label: 'Rated 5 out of 5' -%}
        <p>{{ review_quote }}</p>
        <span class="sh-hero__review-by">{{ review_name }}{% if review_verified != blank %} <span class="s-verified">{{ review_verified }}</span>{% endif %}</span>
      </div>
    {%- endif -%}
  </div>
  <div class="sh-inner sh-hero__inner">
    <div class="sh-hero__copy">
      {%- if rating_label != blank -%}
        <div class="sh-hero__rating">
          {%- if store_rating != blank -%}{%- render 'somna-stars', size: 16, rating: store_rating -%}{%- else -%}{%- render 'somna-stars', size: 16, label: rating_aria -%}{%- endif -%}
          <strong>{{ rating_label }}</strong>
        </div>
      {%- endif -%}
      <h1 id="SomnaHeroTitle-{{ section.id }}" class="sh-hero__title">
        {%- if mobile_heading != blank and mobile_heading != heading -%}
          <span class="sh-hero__title-desktop">{{ heading }}</span><span class="sh-hero__title-mobile">{{ mobile_heading }}</span>
        {%- else -%}
          {{ heading }}
        {%- endif -%}
      </h1>
      {%- if subheading != blank -%}<p class="sh-hero__sub{% if mobile_subheading != blank %} sh-hero__title-desktop{% endif %}">{{ subheading }}</p>{%- endif -%}
      {%- if mobile_subheading != blank -%}<p class="sh-hero__sub sh-hero__title-mobile">{{ mobile_subheading }}</p>{%- endif -%}
      {%- if primary_label != blank or secondary_label != blank -%}
        <div class="sh-hero__ctas" data-sh-sticky-anchor>
          {%- if primary_label != blank -%}<a class="s-btn s-btn--lg sh-hero__primary" href="{{ primary_url }}">{{ primary_label }}</a>{%- endif -%}
          {%- if secondary_label != blank -%}
            {%- if section.settings.secondary_style == 'button' -%}
              <a class="s-btn s-btn--lg s-btn--lavender sh-hero__secondary-btn" href="{{ secondary_url }}">{{ secondary_label }}</a>
            {%- else -%}
              <a class="s-link-arrow sh-hero__secondary" href="{{ secondary_url }}">{{ secondary_label }} {% render 'somna-icon', name: 'arrow-right', size: 18 %}</a>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="sh-hero__trust">
          {%- for block in section.blocks -%}
            {%- liquid
              assign t_full = block.settings.text | replace: '{AppName}', brand
              assign t_short = block.settings.short_text | replace: '{AppName}', brand | strip
            -%}
            <li {{ block.shopify_attributes }}>
              {%- render 'somna-icon', name: block.settings.icon, size: 18 -%}
              {%- if t_short != blank -%}
                <span class="sh-hero__trust-full">{{ t_full }}</span><span class="sh-hero__trust-short">{{ t_short }}</span>
              {%- else -%}
                <span>{{ t_full }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if section.settings.sticky_mobile and primary_label != blank -%}
  {%- assign sticky_label = section.settings.sticky_label | default: primary_label -%}
  <div class="sh sh-sticky" data-sh-sticky hidden>
    {%- liquid
      assign sticky_text = section.settings.sticky_text | replace: '{AppName}', brand
      if sticky_text == blank
        assign g = settings.guarantee_text | split: '·'
        assign sticky_text = g[0] | strip | append: ' · ' | append: g[1] | strip
      endif
    -%}
    {%- if sticky_text != blank -%}<span class="sh-sticky__text">{%- render 'somna-icon', name: 'shield-check', size: 16 -%}{{ sticky_text }}</span>{%- endif -%}
    <a class="s-btn s-btn--md" href="{{ primary_url }}">{{ sticky_label }}</a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Somna hero",
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "Hide on mobile",
      "default": false,
      "info": "Hides this section on screens narrower than 750px."
    },
    {
      "type": "checkbox",
      "id": "sticky_mobile",
      "label": "Sticky buy bar on mobile",
      "default": true,
      "info": "Appears once the hero buttons scroll out of view."
    },
    {
      "type": "text",
      "id": "sticky_label",
      "label": "Sticky bar button",
      "default": "Shop Bestsellers"
    },
    {
      "type": "text",
      "id": "sticky_text",
      "label": "Sticky bar text",
      "default": "100-night trial · Free returns",
      "info": "Blank uses the first two items of the guarantee line."
    },
    {
      "type": "header",
      "content": "Rating"
    },
    {
      "type": "text",
      "id": "rating_label",
      "label": "Rating label",
      "default": "{count}+ Happy Sleepers",
      "info": "{count} = live review total, {rating} = average (Theme settings › Reviews and guarantee). Blank uses the Rating label theme setting."
    },
    {
      "type": "text",
      "id": "rating_aria",
      "label": "Rating description for screen readers",
      "default": "Rated [4.8] out of 5",
      "info": "Used only until live review data exists."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep Cooler. Wake Softer.",
      "info": "Keep it to 2 lines on desktop (about 30 characters)."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Cloud-like pillows and comforters for every kind of sleeper. Try them for [100] nights."
    },
    {
      "type": "text",
      "id": "mobile_heading",
      "label": "Mobile heading",
      "info": "Optional shorter heading for phones (under 750px). Blank uses the heading."
    },
    {
      "type": "textarea",
      "id": "mobile_subheading",
      "label": "Mobile subheading",
      "info": "Optional. Blank uses the subheading."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary action label",
      "default": "Find My Match"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary action link",
      "info": "Blank scrolls to the sleep quiz section (#quiz)."
    },
    {
      "type": "select",
      "id": "secondary_style",
      "label": "Secondary action style",
      "default": "link",
      "options": [
        {
          "value": "link",
          "label": "Text link (recommended)"
        },
        {
          "value": "button",
          "label": "Button"
        }
      ],
      "info": "One solid button keeps the choice simple; the quiz stays one tap away."
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop and tablet image",
      "info": "Wide 16:9, at least 2400 × 1350 px, subject on the right two-thirds, calm space on the left for the text. Set the focal point in Shopify to control the crop."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Portrait 4:5, at least 1200 × 1500 px, subject centred with space at the bottom. Blank uses the desktop image."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman asleep on a {AppName} pillow under a {AppName} comforter"
    },
    {
      "type": "text",
      "id": "shot_code",
      "label": "Placeholder shot code",
      "default": "H-01 · Hero lifestyle"
    },
    {
      "type": "textarea",
      "id": "shot_brief",
      "label": "Placeholder brief",
      "default": "Woman asleep on CloudAlign Pillow under the CloudCool Comforter, warm sunset light through sheer curtains, lavender bedding"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label for screen readers",
      "default": "Photo placeholder H-01"
    },
    {
      "type": "header",
      "content": "Review card"
    },
    {
      "type": "checkbox",
      "id": "show_review",
      "label": "Show review card",
      "default": true
    },
    {
      "type": "textarea",
      "id": "review_quote",
      "label": "Review",
      "default": "\"[Short verified review about sleeping cooler, from your review app]\""
    },
    {
      "type": "text",
      "id": "review_name",
      "label": "Reviewer",
      "default": "[Reviewer name]"
    },
    {
      "type": "text",
      "id": "review_verified",
      "label": "Verified label",
      "default": "✓ Verified Buyer"
    }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "moon",
              "label": "Moon"
            },
            {
              "value": "shield-check",
              "label": "Shield with check"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "snowflake",
              "label": "Snowflake"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "soft",
              "label": "Feather"
            },
            {
              "value": "lock",
              "label": "Lock"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over $[X]"
        },
        {
          "type": "text",
          "id": "short_text",
          "label": "Short text for phones",
          "info": "Keeps the trust row on one line, e.g. 100 nights."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Somna hero",
      "blocks": [
        {
          "type": "trust",
          "settings": {
            "icon": "truck",
            "text": "Free shipping over $[X]",
            "short_text": "Free shipping"
          }
        },
        {
          "type": "trust",
          "settings": {
            "icon": "moon",
            "text": "[100]-night trial",
            "short_text": "[100] nights"
          }
        },
        {
          "type": "trust",
          "settings": {
            "icon": "shield-check",
            "text": "[Lifetime] warranty",
            "short_text": "[Lifetime] warranty"
          }
        }
      ]
    }
  ]
}
{% endschema %}
