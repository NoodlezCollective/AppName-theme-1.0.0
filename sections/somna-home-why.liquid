{%- comment -%}
  Somna "Why Somna" (design: Main / WHY SOMNA). Copy + 16:9 brand film + feature
  cards (blocks). The film plays inline on click (assets/somna-home.js swaps the
  <template> player in), or loops muted when "Autoplay" is on.
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign eyebrow = section.settings.eyebrow | replace: '{AppName}', brand
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign body = section.settings.body | replace: '{AppName}', brand
  assign button_label = section.settings.button_label | replace: '{AppName}', brand
  assign button_url = section.settings.button_url | default: pages.about.url | default: routes.root_url
  assign film_label = section.settings.film_label | replace: '{AppName}', brand

  assign video = section.settings.video
  assign external = section.settings.video_url
  assign poster = section.settings.poster
  if poster == blank and video != blank
    assign poster = video.preview_image
  endif
  assign embed_url = ''
  if external != blank
    if external.type == 'youtube'
      assign embed_url = 'https://www.youtube-nocookie.com/embed/' | append: external.id | append: '?autoplay=1&rel=0'
    elsif external.type == 'vimeo'
      assign embed_url = 'https://player.vimeo.com/video/' | append: external.id | append: '?autoplay=1'
    endif
  endif
  assign has_video = false
  if video != blank and video.sources.size > 0
    assign has_video = true
  endif
  assign playable = false
  if has_video or embed_url != blank
    assign playable = true
  endif
-%}
<section class="sh s-section s-bg-mist" aria-labelledby="SomnaWhyTitle-{{ section.id }}">
  <div class="s-wrap sh-why__inner">
    <div class="sh-why__top">
      <div class="sh-why__copy">
        {%- if eyebrow != blank -%}<span class="s-eyebrow">{{ eyebrow }}</span>{%- endif -%}
        <h2 id="SomnaWhyTitle-{{ section.id }}" class="s-h2 s-balance">{{ heading }}</h2>
        {%- if body != blank -%}<p class="s-lead">{{ body }}</p>{%- endif -%}
        {%- if button_label != blank -%}<a class="s-btn s-btn--white" href="{{ button_url }}">{{ button_label }}</a>{%- endif -%}
      </div>
      <div class="sh-film" data-sh-video>
        {%- if has_video and section.settings.autoplay -%}
          <video autoplay muted loop playsinline{% if poster != blank %} poster="{{ poster | image_url: width: 1600 }}"{% endif %} aria-label="{{ film_label | escape }}">
            {%- for source in video.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
          </video>
        {%- else -%}
          {%- if poster != blank -%}
            {{ poster | image_url: width: 1600 | image_tag: widths: '600, 800, 1000, 1200, 1600', sizes: '(min-width: 1400px) 760px, (min-width: 990px) 55vw, 100vw', loading: 'lazy', alt: '' }}
          {%- endif -%}
          {%- if playable -%}
            <button type="button" class="sh-play" aria-label="Play {{ film_label | escape }}" data-sh-video-play>{%- render 'somna-icon', name: 'play', size: 28 -%}</button>
            <template data-sh-video-player>
              {%- if has_video -%}
                <video controls autoplay playsinline{% if section.settings.loop %} loop{% endif %}{% if poster != blank %} poster="{{ poster | image_url: width: 1600 }}"{% endif %} aria-label="{{ film_label | escape }}">
                  {%- for source in video.sources -%}<source src="{{ source.url }}" type="{{ source.mime_type }}">{%- endfor -%}
                </video>
              {%- else -%}
                <iframe src="{{ embed_url }}" title="{{ film_label | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
              {%- endif -%}
            </template>
          {%- else -%}
            <span class="sh-play" aria-hidden="true">{%- render 'somna-icon', name: 'play', size: 28 -%}</span>
          {%- endif -%}
          {%- if poster == blank -%}
            {%- if section.settings.shot_code != blank -%}<span class="sh-film__code">{{ section.settings.shot_code }}</span>{%- endif -%}
            {%- if section.settings.shot_brief != blank -%}<span class="sh-film__brief">{{ section.settings.shot_brief }}</span>{%- endif -%}
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="sh-why__features">
        {%- for block in section.blocks -%}
          <div class="sh-feature" {{ block.shopify_attributes }}>
            <span class="sh-feature__icon">{%- render 'somna-icon', name: block.settings.icon, size: 26 -%}</span>
            <h3 class="s-h3">{% echo block.settings.title | replace: '{AppName}', brand %}</h3>
            {%- if block.settings.body != blank -%}<p>{% echo block.settings.body | replace: '{AppName}', brand %}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
<script src="{{ 'somna-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Somna why us",
  "max_blocks": 8,
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why {AppName}"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Redefining Sleep, One Soft Detail at a Time"},
    {"type": "textarea", "id": "body", "label": "Text", "default": "Sleep shouldn't be complicated. It should just feel right. Every {AppName} product starts with how you feel at 3am, then works backwards to the materials."},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Our Story"},
    {"type": "url", "id": "button_url", "label": "Button link"},
    {"type": "header", "content": "Brand film"},
    {"type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted. Takes priority over the external URL."},
    {"type": "video_url", "id": "video_url", "label": "External video", "accept": ["youtube", "vimeo"]},
    {"type": "image_picker", "id": "poster", "label": "Poster image", "info": "16:9. Defaults to the video's preview image."},
    {"type": "checkbox", "id": "autoplay", "label": "Autoplay muted and loop (Shopify video only)", "default": false},
    {"type": "checkbox", "id": "loop", "label": "Loop after pressing play", "default": true},
    {"type": "text", "id": "film_label", "label": "Film name for screen readers", "default": "brand film"},
    {"type": "text", "id": "shot_code", "label": "Placeholder shot code", "default": "V-01 · BRAND FILM (30–45s, LOOPING)"},
    {"type": "textarea", "id": "shot_brief", "label": "Placeholder brief", "default": "Slow-motion fabric, a pillow springing back, a comforter settling over a sleeper at dusk"}
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "snowflake",
          "options": [
            {"value": "snowflake", "label": "Snowflake"},
            {"value": "soft", "label": "Feather"},
            {"value": "drop", "label": "Drop"},
            {"value": "moon", "label": "Moon"},
            {"value": "leaf", "label": "Leaf"},
            {"value": "shield-check", "label": "Shield with check"},
            {"value": "truck", "label": "Truck"},
            {"value": "gift", "label": "Gift"},
            {"value": "star", "label": "Star"},
            {"value": "check", "label": "Check"}
          ]
        },
        {"type": "text", "id": "title", "label": "Title", "default": "Temperature-Smart"},
        {"type": "textarea", "id": "body", "label": "Text", "default": "Breathable fabrics designed to move heat away so you stay comfortable from lights-out to alarm."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Somna why us",
      "blocks": [
        {"type": "feature", "settings": {"icon": "snowflake", "title": "Temperature-Smart", "body": "Breathable fabrics designed to move heat away so you stay comfortable from lights-out to alarm."}},
        {"type": "feature", "settings": {"icon": "soft", "title": "Cloud-Soft Feel", "body": "Plush on top, supportive underneath. Soft enough to sink into, structured enough to hold you."}},
        {"type": "feature", "settings": {"icon": "drop", "title": "Easy to Care For", "body": "Machine washable and dryer friendly, so fresh bedding never feels like a chore."}},
        {"type": "feature", "settings": {"icon": "moon", "title": "[100] Nights to Decide", "body": "Your body needs time to adjust. Sleep on it for [100] nights, risk-free."}}
      ]
    }
  ]
}
{% endschema %}
