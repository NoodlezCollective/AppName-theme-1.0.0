{%- comment -%}
  Predictive search results, fetched by assets/collection.js (initPredictive) from
  `routes.predictive_search_url?q=…&resources[type]=product,collection,query&resources[limit]=6&resources[limit_scope]=each&section_id=predictive-search`
  and injected into the search drawer's [data-ps-live] panel.
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- render 'predictive-results',
    products: predictive_search.resources.products,
    collections: predictive_search.resources.collections,
    queries: predictive_search.resources.queries,
    term: predictive_search.terms
  -%}
{%- endif -%}
