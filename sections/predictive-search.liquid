{%- comment -%}
  Predictive search results, fetched by assets/collection.js from
  `routes.predictive_search_url?q=…&resources[type]=product&resources[limit]=5&section_id=predictive-search`
  and injected into the search drawer's `[data-predictive-results]`.
{%- endcomment -%}
{%- if predictive_search.performed -%}
  {%- render 'predictive-results', products: predictive_search.products, term: predictive_search.terms -%}
{%- endif -%}
