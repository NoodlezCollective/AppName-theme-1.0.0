{%- assign brand_token = '{AppName}' -%}
{%- comment -%}
  Password-protected storefront (layout/password.liquid). Same page header and
  form styling as the rest of the theme.
{%- endcomment -%}
<div class="content-page container container--text">
  <header class="page-header page-header--center">
    <p class="eyebrow page-header__eyebrow">{{ settings.brand_name }}</p>
    <h1>{{ section.settings.heading | replace: brand_token, settings.brand_name }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="page-header__description">{{ shop.password_message }}</p>
    {%- elsif section.settings.body != blank -%}
      <p class="page-header__description">{{ section.settings.body | replace: brand_token, settings.brand_name }}</p>
    {%- endif -%}
  </header>

  <div class="account-card account-form">
    {%- form 'storefront_password', class: 'account-form__fieldset' -%}
      <div class="account-form__messages" aria-live="polite">
        {%- if form.errors -%}
          <p class="form-message form-message--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      </div>
      <div class="field">
        <label for="password-form-password">Password</label>
        <input type="password" id="password-form-password" name="password" autocomplete="current-password" placeholder="Enter store password" required>
      </div>
      <button class="btn btn--primary btn--md btn--block" type="submit"><span class="btn__label">{{ section.settings.button_label }}</span></button>
    {%- endform -%}
  </div>

  <p class="text-muted" style="text-align:center;margin-top:1.5rem">Are you the store owner? <a href="{{ routes.root_url }}admin">Log in here</a></p>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Message",
      "default": "Better sleep is almost here. Enter the password to take a look around {AppName}.",
      "info": "Used when the store password message in Shopify settings is empty."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Enter"
    }
  ]
}
{% endschema %}
