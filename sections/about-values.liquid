{%- assign brand_token = '{AppName}' -%}
{%- comment -%}
  "What we stand for" value cards (app/routes/pages.about.tsx,
  DEFAULT_ABOUT_CONTENT.values).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="section section--tight" aria-labelledby="about-values-heading">
  <div class="container">
    <div class="section-heading section-heading--center">
      <h2 id="about-values-heading" class="section-heading__title">{{ section.settings.heading | replace: brand_token, settings.brand_name }}</h2>
    </div>
    <ul class="values-grid">
      {%- for block in section.blocks -%}
        <li class="value-card" {{ block.shopify_attributes }}>
          <span class="value-card__icon">{%- render 'icon', name: block.settings.icon, size: 22, feature: true -%}</span>
          <h3 class="value-card__title">{{ block.settings.title | replace: brand_token, settings.brand_name }}</h3>
          <p class="text-muted">{{ block.settings.body | replace: brand_token, settings.brand_name }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "About values",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What we stand for"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sparkle",
          "options": [
            {"value": "snowflake", "label": "Snowflake"},
            {"value": "heat", "label": "Heat"},
            {"value": "couch", "label": "Couch"},
            {"value": "wash", "label": "Wash"},
            {"value": "feather", "label": "Feather"},
            {"value": "moon", "label": "Moon"},
            {"value": "sparkle", "label": "Sparkle"},
            {"value": "leaf", "label": "Leaf"},
            {"value": "shield", "label": "Shield"},
            {"value": "truck", "label": "Truck"},
            {"value": "check", "label": "Check"}
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Engineered for every sleeper"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Dual-sided fabrics, adaptive fills and ergonomic shapes so hot sleepers, cold sleepers and side sleepers all get their best night."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [
        {"type": "value", "settings": {"icon": "snowflake", "title": "Engineered for every sleeper", "body": "Dual-sided fabrics, adaptive fills and ergonomic shapes so hot sleepers, cold sleepers and side sleepers all get their best night."}},
        {"type": "value", "settings": {"icon": "wash", "title": "Washable by design", "body": "Everything we make survives the washing machine and comes out fluffy. Bedding should be easy to love and easy to clean."}},
        {"type": "value", "settings": {"icon": "moon", "title": "Tested by 124,952+ sleepers", "body": "We iterate on real feedback, from award-winning pillows to the comforter that started it all."}}
      ]
    }
  ]
}
{% endschema %}
