{%- comment -%}
  Reviews section (app/components/home/Testimonials.tsx). A testimonial links
  its product when one is picked; a bare product title renders as text.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign subheading = section.settings.subheading | replace: '{AppName}', brand
-%}
{%- if section.blocks.size > 0 -%}
  <section class="section" aria-labelledby="reviews-heading" id="reviews">
    <div class="container">
      <div class="section-heading section-heading--center">
        <h2 id="reviews-heading" class="section-heading__title">{{ heading }}</h2>
        {%- if subheading != blank -%}<p class="section-heading__subtitle">{{ subheading }}</p>{%- endif -%}
      </div>
      <ul class="testimonials">
        {%- for block in section.blocks -%}
          {%- liquid
            assign quote = block.settings.quote | replace: '{AppName}', brand
            assign author = block.settings.author | replace: '{AppName}', brand | default: 'Customer'
            assign product = block.settings.product
            assign product_title = product.title | default: block.settings.product_title | replace: '{AppName}', brand
          -%}
          <li class="testimonial" {{ block.shopify_attributes }}>
            {%- if block.settings.show_rating -%}
              {%- render 'stars', rating: block.settings.rating, size: 'sm' -%}
            {%- endif -%}
            <blockquote class="testimonial__quote">“{{ quote }}”</blockquote>
            <div class="testimonial__meta">
              <span class="testimonial__author">{{ author }}</span>
              {%- if product != blank -%}
                <a class="testimonial__product" href="{{ product.url }}">{{ product_title }}</a>
              {%- elsif product_title != blank -%}
                <span class="testimonial__product">{{ product_title }}</span>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved By 124,952+ Sleepers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real reviews from people who stopped fighting their bedding."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Best sleep in years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Customer"
        },
        {
          "type": "checkbox",
          "id": "show_rating",
          "label": "Show star rating",
          "default": true
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 5
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Links the testimonial to the product."
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product title",
          "info": "Shown without a link when no product is picked."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {"type": "testimonial", "settings": {"quote": "I wake up without neck pain for the first time in years. The CloudAlign actually keeps my head where it should be.", "author": "Jenna R.", "rating": 5, "product": "cloudalign-pillow", "product_title": "CloudAlign Pillow"}},
        {"type": "testimonial", "settings": {"quote": "The cool side is genuinely cool. I flip it in summer and my partner keeps the plush side. We finally agree on a comforter.", "author": "Marcus T.", "rating": 5, "product": "cloudcool-cooling-comforter", "product_title": "CloudCool Cooling Comforter"}},
        {"type": "testimonial", "settings": {"quote": "It washed beautifully and came out of the dryer just as fluffy. Hotel-bed feel at home.", "author": "Priya S.", "rating": 5, "product": "marshmellow-comforter", "product_title": "MarshMellow Comforter"}}
      ]
    }
  ]
}
{% endschema %}
