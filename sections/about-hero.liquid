{%- assign brand_token = '{AppName}' -%}
{%- comment -%}
  About page hero (app/routes/pages.about.tsx, DEFAULT_ABOUT_CONTENT.hero).
{%- endcomment -%}
{%- capture newline %}
{% endcapture -%}
{%- liquid
  assign heading_lines = section.settings.heading | replace: '{AppName}', settings.brand_name | strip | split: newline
  assign cta_url = section.settings.cta_url | default: routes.all_products_collection_url
  assign image = section.settings.image
  assign image_alt = section.settings.image_alt | default: image.alt | replace: '{AppName}', settings.brand_name
-%}
<section class="container" style="padding-top:1.5rem" aria-labelledby="about-hero-heading">
  <div class="about-hero">
    <div class="about-hero__content">
      <h1 id="about-hero-heading" class="about-hero__heading">
        {%- for line in heading_lines -%}
          {%- assign trimmed = line | strip -%}
          {%- if trimmed != blank -%}{{ trimmed }}{% unless forloop.last %}<br>{% endunless %}{%- endif -%}
        {%- endfor -%}
      </h1>
      {%- if section.settings.subheading != blank -%}
        <p class="about-hero__sub">{{ section.settings.subheading | replace: brand_token, settings.brand_name }}</p>
      {%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="btn btn--primary btn--md" href="{{ cta_url }}"><span class="btn__label">{{ section.settings.cta_label }}</span></a>
      {%- endif -%}
    </div>
    <div class="about-hero__media">
      {%- if image != blank -%}
        {{ image | image_url: width: 1800 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600, 1800', sizes: '(min-width: 64em) 60vw, 100vw', loading: 'eager', decoding: 'async', fetchpriority: 'high', alt: image_alt }}
      {%- elsif section.settings.show_placeholder -%}
        <img src="{{ 'placeholder-about-hero.svg' | asset_url }}" alt="{{ image_alt | escape }}" width="900" height="450" loading="eager" decoding="async" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About hero",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep Was Broken.\nWe Fixed It.",
      "info": "One line per row."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bedding and sleepwear, done right. Engineered for better sleep."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to the all-products collection."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Woman resting on a {AppName} pillow"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder artwork when no image is set",
      "default": true
    }
  ],
  "presets": [{"name": "About hero"}]
}
{% endschema %}
