{%- comment -%}
  Somna product reviews (Product design, #reviews): summary column (average,
  stars, count, star distribution, Write a Review) and the review list with
  topic pills and "Load more reviews" (assets/product.js).
  Data: reviews.rating + reviews.rating_count (average and count) and the
  `mellow_review` metaobjects in `mellow.featured_reviews` (fields: body,
  rating, title, author, date, verified; optional `meta`, e.g. "Side sleeper
  · Queen · Medium", `tags` and `photo`). Topic pills match the review's meta
  and tags; "With photos" matches reviews that have a photo. Review apps can
  be added as app blocks.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name
  assign rating = nil
  assign rating_field = product.metafields.reviews.rating
  if rating_field.value.rating != blank
    assign rating = rating_field.value.rating | times: 5.0 | divided_by: rating_field.value.scale_max
  elsif rating_field.value != blank
    assign rating = rating_field.value | plus: 0.0
    if rating < 0 or rating > 5
      assign rating = nil
    endif
  endif
  assign rating_count = product.metafields.reviews.rating_count.value | plus: 0

  assign reviews = product.metafields.mellow.featured_reviews.value
  assign review_count = 0
  for review in reviews
    assign review_body = review.body.value | strip
    if review_body != blank
      assign review_count = review_count | plus: 1
    endif
  endfor
  assign page_size = section.settings.page_size
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign write_url = section.settings.write_url | default: '#reviews'
-%}
{{ 'somna-product.css' | asset_url | stylesheet_tag }}
<section class="sp-reviews" id="reviews" aria-labelledby="reviews-heading-{{ section.id }}">
  <div class="sp-reviews__inner">
    <div class="sp-reviews__summary">
      <h2 class="s-h2" id="reviews-heading-{{ section.id }}">{{ heading }}</h2>
      {%- if rating != nil -%}
        <div class="sp-reviews__score">
          <span class="sp-reviews__avg">{{ rating | round: 1 }}</span>
          <div class="sp-reviews__score-meta">
            {%- render 'product-stars', rating: rating, size: 18 -%}
            {%- if rating_count > 0 -%}
              {%- capture count_text -%}{%- render 'number', value: rating_count -%}{%- endcapture -%}
              <span class="sp-reviews__based">{% echo section.settings.based_on | replace: '{count}', count_text %}</span>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.show_distribution -%}
          <div class="sp-reviews__dist">
            {%- for star in (1..5) reversed -%}
              {%- liquid
                assign key = 'dist_' | append: star
                assign pct = section.settings[key]
                assign star_count = rating_count | times: pct | divided_by: 100.0 | round
              -%}
              <div class="sp-reviews__dist-row">
                <span class="sp-reviews__dist-label">{{ star }} ★</span>
                <div class="sp-reviews__dist-track"><div class="sp-reviews__dist-bar" style="width: {{ pct }}%;"></div></div>
                <span class="sp-reviews__dist-count">{% if rating_count > 0 %}{% render 'number', value: star_count %}{% endif %}</span>
              </div>
            {%- endfor -%}
          </div>
          {%- if section.settings.dist_note != blank -%}<span class="s-note">{{ section.settings.dist_note }}</span>{%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.write_label != blank -%}
        <a class="s-btn s-btn--md s-btn--lavender sp-reviews__write" href="{{ write_url }}">{{ section.settings.write_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="sp-reviews__list" data-review-list data-page-size="{{ page_size }}">
      {%- if review_count > 0 -%}
        {%- assign pill_lines = section.settings.topics | newline_to_br | split: '<br />' -%}
        {%- capture pills -%}
          {%- assign pill_index = 0 -%}
          {%- for line in pill_lines -%}
            {%- assign pill_label = line | strip -%}
            {%- if pill_label == blank -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign term = ''
              if pill_index > 0
                assign term = pill_label | downcase
                assign last_char = term | slice: -1, 1
                if last_char == 's'
                  assign cut = term.size | minus: 1
                  assign term = term | slice: 0, cut
                endif
              endif
            -%}
            <button type="button" class="sp-reviews__pill" aria-pressed="{% if pill_index == 0 %}true{% else %}false{% endif %}" data-review-filter="{{ term | escape }}">{{ pill_label | escape }}</button>
            {%- assign pill_index = pill_index | plus: 1 -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if pills != blank -%}<div class="sp-reviews__pills" role="group" aria-label="Filter reviews">{{ pills }}</div>{%- endif -%}

        {%- assign shown = 0 -%}
        {%- for review in reviews -%}
          {%- liquid
            assign body = review.body.value | strip
            if body == blank
              continue
            endif
            assign shown = shown | plus: 1
            assign review_rating = nil
            if review.rating.value.rating != blank
              assign review_rating = review.rating.value.rating | times: 5.0 | divided_by: review.rating.value.scale_max
            elsif review.rating.value != blank
              assign review_rating = review.rating.value | plus: 0.0
            endif
            assign title = review.title.value | strip
            assign author = review.author.value | strip | default: 'Customer'
            assign date = review.date.value
            assign meta = review.meta.value | strip
            assign tag_text = review.tags.value | join: ' '
            assign photo = review.photo.value
            assign tags = meta | append: ' ' | append: tag_text | append: ' ' | append: title | append: ' ' | append: body | downcase
            if photo != blank
              assign tags = tags | append: ' with photos'
            endif
          -%}
          <article class="sp-review" data-review data-review-tags="{{ tags | escape }}"{% if shown > page_size %} hidden{% endif %}>
            <div class="sp-review__top">
              {%- render 'product-stars', rating: review_rating, size: 15 -%}
              {%- if date != blank -%}<time class="sp-review__date" datetime="{{ date | date: '%Y-%m-%d' }}">{{ date | date: '%b %-d, %Y' }}</time>{%- endif -%}
            </div>
            {%- if title != blank -%}<h3 class="sp-review__title">{{ title | escape }}</h3>{%- endif -%}
            <p class="sp-review__body">{{ body | escape | newline_to_br }}</p>
            {%- if photo != blank and photo.preview_image -%}
              {{ photo.preview_image | image_url: width: 240, height: 240, crop: 'center' | image_tag: class: 'sp-review__photo', alt: '', width: 96, height: 96, loading: 'lazy' }}
            {%- endif -%}
            <span class="sp-review__meta">{{ author | escape }}{% if review.verified.value == true %} · <span class="s-verified">✓ Verified Buyer</span>{% endif %}{% if meta != blank %} · {{ meta | escape }}{% endif %}</span>
          </article>
        {%- endfor -%}
        <p class="sp-reviews__empty s-muted" data-reviews-empty hidden>{{ section.settings.empty_filter }}</p>
        {%- if review_count > page_size -%}
          <a class="sp-reviews__more" href="#reviews" data-reviews-more>{{ section.settings.more_label | escape }}</a>
        {%- endif -%}
      {%- elsif section.blocks.size == 0 -%}
        <p class="s-muted">{{ section.settings.empty }}</p>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}<div class="sp-reviews__app">{% render block %}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product reviews",
  "tag": "div",
  "class": "section-product-reviews",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "based_on",
      "label": "Count line",
      "default": "Based on {count} verified reviews",
      "info": "{count} is replaced with reviews.rating_count."
    },
    {
      "type": "checkbox",
      "id": "show_distribution",
      "label": "Show star distribution",
      "default": true
    },
    {
      "type": "range",
      "id": "dist_5",
      "label": "5 stars (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 84
    },
    {
      "type": "range",
      "id": "dist_4",
      "label": "4 stars (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "dist_3",
      "label": "3 stars (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "dist_2",
      "label": "2 stars (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "dist_1",
      "label": "1 star (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 1
    },
    {
      "type": "text",
      "id": "dist_note",
      "label": "Note under the bars",
      "default": "Bar lengths are illustrative until your review app is connected."
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Write a review button",
      "default": "Write a Review"
    },
    {
      "type": "url",
      "id": "write_url",
      "label": "Write a review link"
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Topic pills",
      "default": "All\nSide sleepers\nNeck pain\nWith photos",
      "info": "One per line; the first shows every review."
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Reviews shown before \"Load more\"",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Load more label",
      "default": "Load more reviews"
    },
    {
      "type": "text",
      "id": "empty",
      "label": "Message without reviews",
      "default": "No reviews yet. Be the first to share how you sleep."
    },
    {
      "type": "text",
      "id": "empty_filter",
      "label": "Message when a topic has no reviews",
      "default": "No reviews on this topic yet."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product reviews"
    }
  ]
}
{% endschema %}
