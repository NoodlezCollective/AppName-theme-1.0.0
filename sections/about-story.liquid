{%- assign brand_token = '{AppName}' -%}
{%- comment -%}
  About page story card with the two photos (app/routes/pages.about.tsx,
  DEFAULT_ABOUT_CONTENT.story / imageLeft / imageBottom).
{%- endcomment -%}
{%- liquid
  assign image_left = section.settings.image_left
  assign image_bottom = section.settings.image_bottom
  assign image_left_alt = section.settings.image_left_alt | default: image_left.alt | replace: '{AppName}', settings.brand_name
  assign image_bottom_alt = section.settings.image_bottom_alt | default: image_bottom.alt | replace: '{AppName}', settings.brand_name
-%}
<section class="section section--tight" aria-labelledby="about-story-heading">
  <div class="container about-story">
    {%- if image_left != blank or section.settings.show_placeholders -%}
      <div class="about-story__image-left">
        {%- if image_left != blank -%}
          {{ image_left | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 64em) 50vw, 100vw', loading: 'lazy', decoding: 'async', alt: image_left_alt }}
        {%- else -%}
          <img src="{{ 'placeholder-about-left.svg' | asset_url }}" alt="{{ image_left_alt | escape }}" width="688" height="560" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="about-story__card">
      <h2 id="about-story-heading">{{ section.settings.heading | replace: brand_token, settings.brand_name }}</h2>
      <p>
        {{- section.settings.body | replace: brand_token, settings.brand_name -}}
        {%- if section.settings.highlight != blank %} <span class="about-story__highlight">{{ section.settings.highlight | replace: brand_token, settings.brand_name }}</span>{% endif -%}
      </p>
    </div>
    {%- if image_bottom != blank or section.settings.show_placeholders -%}
      <div class="about-story__image-bottom">
        {%- if image_bottom != blank -%}
          {{ image_bottom | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1400', sizes: '(min-width: 64em) 50vw, 100vw', loading: 'lazy', decoding: 'async', alt: image_bottom_alt }}
        {%- else -%}
          <img src="{{ 'placeholder-about-bottom.svg' | asset_url }}" alt="{{ image_bottom_alt | escape }}" width="688" height="300" loading="lazy" decoding="async">
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "About story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How {AppName} was created to redefine sleep"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Most comforters make you choose: too hot or too cold, too heavy or too light, impossible to wash or just plain uncomfortable."
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted sentence",
      "default": "It shouldn't be this complicated."
    },
    {
      "type": "image_picker",
      "id": "image_left",
      "label": "Left image"
    },
    {
      "type": "text",
      "id": "image_left_alt",
      "label": "Left image alt text",
      "default": "Woman smiling while resting on {AppName} pillows"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "Bottom image"
    },
    {
      "type": "text",
      "id": "image_bottom_alt",
      "label": "Bottom image alt text",
      "default": "Hand pressing into a {AppName} comforter"
    },
    {
      "type": "checkbox",
      "id": "show_placeholders",
      "label": "Show placeholder artwork when no image is set",
      "default": true
    }
  ],
  "presets": [{"name": "About story"}]
}
{% endschema %}
