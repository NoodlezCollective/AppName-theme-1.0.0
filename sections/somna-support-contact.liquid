{%- comment -%}
  "Talk to a human" (design: Support.dc, "CONTACT"): contact cards and the
  "Send Us a Message" form, which uses the Shopify contact form so messages
  arrive in the store's inbox.
{%- endcomment -%}
{{ 'somna-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'somna-pages.js' | asset_url }}" defer></script>
{%- assign topics = section.settings.topics | newline_to_br | split: '<br />' -%}
<section class="s-pg s-scontact" id="contact" aria-labelledby="ContactTitle-{{ section.id }}">
  <div class="s-scontact__inner">
    <div class="s-pg-head-center">
      {%- if section.settings.eyebrow != blank -%}<span class="s-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="s-h2" id="ContactTitle-{{ section.id }}">{% echo section.settings.heading | replace: '{AppName}', settings.brand_name | escape %}</h2>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="s-scontact__cards">
        {%- for block in section.blocks -%}
          <div class="s-ccard" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}<span class="s-ccard__icon">{%- render 'somna-icon', name: block.settings.icon, size: 28 -%}</span>{%- endif -%}
            <h3 class="s-ccard__h3">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p>{% echo block.settings.text | replace: '{AppName}', settings.brand_name | escape %}</p>{%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a class="s-ccard__strong s-ccard__link" style="text-decoration: underline;" href="{{ block.settings.link | default: '#' }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_form -%}
      {%- form 'contact', id: 'SomnaContactForm', class: 's-scontact__form', data-somna-form: '' -%}
        {%- assign contact_sent = false -%}
        {%- if form.posted_successfully? -%}{%- assign contact_sent = true -%}{%- endif -%}
        <h3 class="s-ccard__h3" style="line-height: 1.6;">{{ section.settings.form_title | escape }}</h3>
        <div class="s-stack" style="gap: 18px;" data-somna-fields{% if contact_sent %} hidden{% endif %}>
          {%- if form.errors -%}
            <p class="s-pg-status s-pg-status--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="s-scontact__row">
            <div class="s-field">
              <label class="s-label" for="ContactName-{{ section.id }}">Name</label>
              <input class="s-input" id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
            </div>
            <div class="s-field">
              <label class="s-label" for="ContactEmail-{{ section.id }}">Email</label>
              <input class="s-input" id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
            </div>
          </div>
          <div class="s-scontact__row">
            <div class="s-field">
              <label class="s-label" for="ContactTopic-{{ section.id }}">Topic</label>
              <select class="s-input" id="ContactTopic-{{ section.id }}" name="contact[Topic]">
                {%- for topic in topics -%}
                  {%- assign topic_label = topic | strip -%}
                  {%- if topic_label != blank -%}<option>{{ topic_label | escape }}</option>{%- endif -%}
                {%- endfor -%}
              </select>
            </div>
            <div class="s-field">
              <label class="s-label" for="ContactOrder-{{ section.id }}">Order number <span class="s-label__opt">(optional)</span></label>
              <input class="s-input" id="ContactOrder-{{ section.id }}" type="text" name="contact[Order number]">
            </div>
          </div>
          <div class="s-field">
            <label class="s-label" for="ContactMessage-{{ section.id }}">Message</label>
            <textarea class="s-input" id="ContactMessage-{{ section.id }}" name="contact[body]" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="s-btn">{{ section.settings.button_label | escape }}</button>
        </div>
        <div class="s-stack" style="gap: 16px;" data-somna-done role="status"{% unless contact_sent %} hidden{% endunless %}>
          <p class="s-pg-status">{% echo section.settings.success_text | replace: '{AppName}', settings.brand_name | escape %}</p>
          <button type="button" class="s-pill-btn" style="align-self: flex-start;" data-somna-reset>Send another message</button>
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact the team",
  "class": "s-section-support-contact",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Talk to a human"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Our Sleep Team Is Here for You"},
    {"type": "checkbox", "id": "show_form", "label": "Show message form", "default": true},
    {"type": "text", "id": "form_title", "label": "Form title", "default": "Send Us a Message"},
    {"type": "textarea", "id": "topics", "label": "Topic options", "default": "Order & shipping\nReturn or exchange\nWarranty claim\nProduct question\nSomething else", "info": "One per line."},
    {"type": "text", "id": "button_label", "label": "Button", "default": "Send Message"},
    {"type": "text", "id": "success_text", "label": "Message after sending", "default": "Thanks for your message. Our sleep team will reply within [24 hours]."}
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Contact card",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "mail",
          "options": [
            {"value": "mail", "label": "Email"},
            {"value": "pin", "label": "Location"},
            {"value": "user", "label": "Person"},
            {"value": "truck", "label": "Delivery"},
            {"value": "shield-check", "label": "Shield"},
            {"value": "none", "label": "None"}
          ]
        },
        {"type": "text", "id": "title", "label": "Title", "default": "Email"},
        {"type": "text", "id": "text", "label": "Text", "default": "We reply within [24 hours], 7 days a week."},
        {"type": "text", "id": "link_label", "label": "Link label", "default": "hello@[yourdomain].com"},
        {"type": "text", "id": "link", "label": "Link", "default": "mailto:hello@[yourdomain].com", "info": "For example mailto:hello@yourdomain.com"}
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact the team",
      "blocks": [{"type": "card"}]
    }
  ]
}
{% endschema %}
