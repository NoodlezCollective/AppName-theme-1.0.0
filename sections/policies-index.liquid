{%- comment -%}
  Policies index (template page.policies): a grid of soft cards in the Somna
  look, one per policy page. Each block links to its page (or /pages/<handle>
  until that page exists).
{%- endcomment -%}
{{ 'somna-pages.css' | asset_url | stylesheet_tag }}
<section class="s-pg s-pidx">
  <ul class="s-pidx__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign policy_page = block.settings.page
        assign handle = policy_page.handle | default: block.settings.handle | strip
        if policy_page == blank
          assign policy_page = pages[handle]
        endif
        assign title = block.settings.title | default: policy_page.title | default: handle | replace: '{AppName}', settings.brand_name
        assign description = block.settings.description | replace: '{AppName}', settings.brand_name
      -%}
      <li {{ block.shopify_attributes }}>
        <a class="s-pidx__card" href="{% if policy_page.url != blank %}{{ policy_page.url }}{% else %}{% render 'somna-policy-url', handle: handle %}{% endif %}">
          <span class="s-pidx__title">{{ title | escape }}</span>
          {%- if description != blank -%}<span class="s-pidx__desc">{{ description | escape }}</span>{%- endif -%}
          <span class="s-pidx__more">{{ section.settings.link_label | default: 'Read policy' | escape }} {% render 'somna-icon', name: 'arrow-right', size: 18 %}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Policies list",
  "class": "s-section-policies-index",
  "settings": [
    {
      "type": "text",
      "id": "link_label",
      "label": "Card link label",
      "default": "Read policy"
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Policy",
      "settings": [
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Page handle",
          "default": "privacy-policy",
          "info": "Used while no page is picked above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Privacy Policy"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "What we collect, why we collect it, and the choices you have."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Policies list",
      "blocks": [
        {"type": "policy", "settings": {"handle": "refund-policy", "title": "Returns & Refunds", "description": "Sleep on it for [100] nights. If it isn't right, we'll make it right."}},
        {"type": "policy", "settings": {"handle": "shipping-policy", "title": "Shipping Policy", "description": "Processing times, rates, delivery and tracking."}},
        {"type": "policy", "settings": {"handle": "privacy-policy", "title": "Privacy Policy", "description": "What we collect, why we collect it, and the choices you have."}},
        {"type": "policy", "settings": {"handle": "terms-of-service", "title": "Terms of Service", "description": "The rules for shopping with {AppName}, written as plainly as the law allows."}}
      ]
    }
  ]
}
{% endschema %}
