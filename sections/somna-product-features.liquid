{%- comment -%}
  Feature splits (Product design): image + eyebrow, heading and text,
  alternating sides. Without an image each split shows the design's
  labelled photo placeholder (shot code + brief).
{%- endcomment -%}
{%- assign brand = settings.brand_name -%}
{{ 'somna-product.css' | asset_url | stylesheet_tag }}
{%- if section.blocks.size > 0 -%}
<section class="sp-splits">
  <div class="sp-splits__inner">
    {%- for block in section.blocks -%}
      {%- liquid
        assign title = block.settings.title | replace: '{AppName}', brand | replace: '{title}', product.title
        assign reverse = false
        assign mod = forloop.index0 | modulo: 2
        if mod == 1
          assign reverse = true
        endif
      -%}
      <div class="sp-split{% if reverse %} sp-split--reverse{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="s-media sp-split__media">
            {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 600, 800, 1000, 1200, 1600', sizes: '(min-width: 75em) 576px, (min-width: 48em) 50vw, 100vw', loading: 'lazy', alt: block.settings.image.alt | default: title }}
          </div>
        {%- else -%}
          <div class="sp-split__media sp-split__ph" role="img" aria-label="Photo placeholder {{ block.settings.shot | escape }}">
            {%- render 'somna-icon', name: 'camera', size: 30 -%}
            {%- if block.settings.shot != blank -%}<span class="s-ph__code">{{ block.settings.shot }}</span>{%- endif -%}
            {%- if block.settings.brief != blank -%}<span class="sp-split__brief">{{ block.settings.brief }}</span>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="sp-split__copy">
          {%- if block.settings.eyebrow != blank -%}<span class="s-eyebrow">{% echo block.settings.eyebrow | replace: '{AppName}', brand %}</span>{%- endif -%}
          {%- if title != blank -%}<h2 class="s-h2 s-balance">{{ title }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="sp-split__text">{% echo block.settings.text | replace: '{AppName}', brand %}</div>{%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Feature splits",
  "tag": "div",
  "class": "section-somna-product-features",
  "max_blocks": 6,
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "split",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Alignment"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Supports Your Neck, However You Sleep",
          "info": "{title} is replaced with the product title."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A gently contoured profile cradles your head and fills the gap at your neck, so your spine stays in line whether you start on your back or drift to your side.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "shot",
          "label": "Placeholder shot code",
          "default": "PD-01"
        },
        {
          "type": "text",
          "id": "brief",
          "label": "Placeholder brief",
          "default": "Alignment infographic: side sleeper with spine line, callouts for contour and loft"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature splits",
      "blocks": [
        {
          "type": "split"
        },
        {
          "type": "split",
          "settings": {
            "eyebrow": "Cooling",
            "title": "A Cover That Breathes",
            "text": "<p>The cover is designed to feel cool to the touch and let warm air escape, so you’re not flipping to the cold side at 2am.</p>",
            "shot": "PD-02",
            "brief": "Macro of cover fabric with subtle airflow graphic, cool lavender light"
          }
        },
        {
          "type": "split",
          "settings": {
            "eyebrow": "Easy care",
            "title": "Fresh Every Week",
            "text": "<p>Unzip, wash, zip. [Describe any adjustable fill or other feature here if the product has one.]</p>",
            "shot": "PD-03",
            "brief": "Hands unzipping the cover beside a laundry basket, bright daylight"
          }
        }
      ]
    }
  ]
}
{% endschema %}
