{%- comment -%}
  "Redefining Sleep" section (app/components/home/Story.tsx + VideoCard.tsx).
  The poster shows with a play button; assets/home.js swaps in the native
  <video> (Shopify-hosted file) or the YouTube/Vimeo iframe held in the
  <template> and moves focus to it. Without a playable source the poster is
  shown without a dead control.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign body = section.settings.body | replace: '{AppName}', brand
  assign cta_label = section.settings.cta_label | replace: '{AppName}', brand
  assign cta_url = section.settings.cta_url | default: pages.about.url
  assign video = section.settings.video
  assign external = section.settings.video_url
  assign poster = section.settings.poster
  if poster == blank and video != blank
    assign poster = video.preview_image
  endif
  assign poster_alt = poster.alt | default: section.settings.poster_alt | replace: '{AppName}', brand
  if poster_alt == blank
    assign poster_alt = heading
  endif
  assign embed_url = ''
  if external != blank
    if external.type == 'youtube'
      assign embed_url = 'https://www.youtube-nocookie.com/embed/' | append: external.id | append: '?autoplay=1&amp;rel=0'
    elsif external.type == 'vimeo'
      assign embed_url = 'https://player.vimeo.com/video/' | append: external.id | append: '?autoplay=1'
    endif
  endif
  assign playable = false
  if video != blank and video.sources.size > 0
    assign playable = true
  elsif embed_url != blank
    assign playable = true
  endif
  if poster != blank
    assign poster_url = poster | image_url: width: 1600
  else
    assign poster_url = 'placeholder-story-poster.svg' | asset_url
  endif
-%}
<section class="section" aria-labelledby="story-heading">
  <div class="container story">
    <div class="story__content">
      <h2 id="story-heading">{{ heading }}</h2>
      <p class="story__body">{{ body }}</p>
      {%- if cta_label != blank and cta_url != blank -%}
        <a class="btn btn--outline btn--md" href="{{ cta_url }}"><span class="btn__label">{{ cta_label }}</span></a>
      {%- endif -%}
    </div>
    <div class="video-card" data-video-card>
      {%- if poster != blank -%}
        {%- render 'image', image: poster, alt: poster_alt, sizes: '(min-width: 64em) 50vw, 100vw' -%}
      {%- else -%}
        {%- render 'image', placeholder: 'placeholder-story-poster.svg', alt: poster_alt, width: 1336, height: 750 -%}
      {%- endif -%}
      {%- if playable -%}
        <button type="button" class="video-card__play" aria-label="Play video: {{ heading | escape }}" data-video-play>
          <span class="video-card__play-icon">{%- render 'icon', name: 'play', size: 30 -%}</span>
        </button>
        <template data-video-player>
          {%- if video != blank and video.sources.size > 0 -%}
            <video controls autoplay playsinline poster="{{ poster_url }}" aria-label="{{ heading | escape }}">
              {%- for source in video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- else -%}
            <iframe src="{{ embed_url }}" title="{{ heading | escape }}" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}
    </div>
  </div>
</section>
<script src="{{ 'home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Story",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Redefining Sleep. One Innovation At A Time."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "{AppName} started with a comforter that changed everything. Now, we're building a new standard for sleep with more innovative fabrics, dual-sided cooling, cloud-like pillows and effortless design. Sleep shouldn't be complicated. It should just feel right."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "A Shopify-hosted video. Takes priority over the external video URL."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster image",
      "info": "Shown before the video plays. Placeholder artwork is used until one is chosen."
    },
    {
      "type": "text",
      "id": "poster_alt",
      "label": "Poster alt text",
      "default": "{AppName} brand film"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to the page with the handle \"about\"."
    }
  ],
  "presets": [{"name": "Story"}]
}
{% endschema %}
