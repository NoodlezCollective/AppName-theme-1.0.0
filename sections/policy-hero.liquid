{%- comment -%}
  Soft lavender banner above policy and information pages (design: Standard,
  Returns, Privacy, Terms, Payment, Contact, Legal, DoNotSell): breadcrumb
  Home / Support / <page title>, eyebrow, h1, sub and an optional meta line.
  Copy defaults per page handle and can be replaced per page with a
  "Page copy" block. With the page.policies template it renders the index.
  Tokens: {AppName} brand name, {date} the page's publish date,
  {minutes} reading time of the document.
{%- endcomment -%}
{{ 'somna-pages.css' | asset_url | stylesheet_tag }}
{%- capture dns_sub -%}{AppName} doesn't sell your personal information for money. Some advertising cookies may count as "sharing" under certain US state laws. You can switch that off here, any time.{%- endcapture -%}
{%- liquid
  assign handle = page.handle
  assign effective = 'Effective {date} · {minutes} min read'
  assign eyebrow = 'Policies'
  assign headline = page.title
  assign sub = ''
  assign meta = ''
  assign wide = false
  assign default_minutes = 0
  assign parent_handle = section.settings.parent_page.handle | default: 'support'
  assign parent_label = section.settings.parent_label | default: 'Support'

  case handle
    when 'refund-policy'
      assign default_minutes = 4
      assign eyebrow = 'Return & Refund Policy'
      assign headline = 'Returns, Made Simple'
      assign sub = "Sleep on it for [100] nights. If it isn't right, we'll make it right."
      assign meta = effective
    when 'shipping-policy'
      assign eyebrow = 'Policies'
      assign headline = 'Shipping Policy'
      assign sub = 'Everything you need to know about getting your {AppName} order to your door. Last updated {date}.'
    when 'privacy-policy'
      assign default_minutes = 7
      assign eyebrow = 'Privacy Policy'
      assign headline = 'Your Privacy, Made Simple'
      assign sub = 'What we collect, why we collect it, and the choices you have. We never sell your personal information.'
      assign meta = effective
    when 'terms-of-service'
      assign default_minutes = 12
      assign eyebrow = 'Terms of Service'
      assign headline = 'Our Terms, Made Simple'
      assign sub = 'The rules for shopping with {AppName}, written as plainly as the law allows.'
      assign meta = effective
    when 'payment-policy'
      assign default_minutes = 4
      assign eyebrow = 'Payment Policy'
      assign headline = 'Payments, Made Simple'
      assign sub = "How you can pay, when you're charged, and how we keep every payment secure."
      assign meta = effective
    when 'contact-information'
      assign eyebrow = 'Contact Information'
      assign headline = "We're Here to Help"
      assign sub = 'Real people, real answers. Reach the right team below, usually within [24 hours].'
    when 'legal-notice'
      assign eyebrow = 'Legal Notice'
      assign headline = "Who's Behind {AppName}"
      assign sub = 'The company details, ownership and legal information for [yourdomain].com.'
      assign meta = 'Last updated {date}'
    when 'do-not-sell'
      assign eyebrow = 'Your privacy choices'
      assign headline = 'Do Not Sell or Share My Personal Information'
      assign sub = dns_sub
      assign wide = true
      assign parent_handle = 'privacy-policy'
      assign parent_label = pages['privacy-policy'].title | default: 'Privacy Policy'
  endcase

  if template.suffix == 'policies'
    assign eyebrow = 'Support'
    assign headline = 'Our Policies'
    assign sub = 'The fine print, in plain language: how we ship, how returns work and how we look after your information.'
    assign meta = ''
    assign wide = false
  endif

  for block in section.blocks
    if block.settings.page != blank and block.settings.page.handle == handle
      if block.settings.eyebrow != blank
        assign eyebrow = block.settings.eyebrow
      endif
      if block.settings.headline != blank
        assign headline = block.settings.headline
      endif
      if block.settings.subheadline != blank
        assign sub = block.settings.subheadline
      endif
      if block.settings.hide_meta
        assign meta = ''
      elsif block.settings.meta != blank
        assign meta = block.settings.meta
      endif
    endif
  endfor

  assign date = page.published_at | date: '%B %-d, %Y'
  if date == blank
    assign date = 'now' | date: '%B %-d, %Y'
  endif

  if meta contains '{minutes}'
    if page.content == blank and default_minutes > 0
      assign minutes = default_minutes
    else
      if page.content != blank
        assign doc_text = page.content
      else
        capture doc_text
          render 'somna-policy-doc', handle: handle, part: 'body'
        endcapture
      endif
      assign words = doc_text | strip_html | newline_to_br | replace: '<br />', ' ' | split: ' ' | size
      assign wpm = section.settings.words_per_minute | default: 200
      assign minutes = words | plus: wpm | minus: 1 | divided_by: wpm
      if minutes < 1
        assign minutes = 1
      endif
    endif
    assign meta = meta | replace: '{minutes}', minutes
  endif

  assign eyebrow = eyebrow | replace: '{AppName}', settings.brand_name
  assign headline = headline | replace: '{AppName}', settings.brand_name
  assign sub = sub | replace: '{AppName}', settings.brand_name | replace: '{date}', date
  assign meta = meta | replace: '{AppName}', settings.brand_name | replace: '{date}', date
-%}
<section class="s-pg s-page-hero s-phero" aria-labelledby="PolicyHeroTitle-{{ section.id }}">
  <div class="s-wrap s-wrap--1200 s-page-hero__inner">
    <nav class="s-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a> <span aria-hidden="true">/</span>
      <a href="{% render 'somna-policy-url', handle: parent_handle %}">{{ parent_label | escape }}</a> <span aria-hidden="true">/</span>
      <span aria-current="page">{{ page.title }}</span>
    </nav>
    {%- if eyebrow != blank -%}<span class="s-eyebrow">{{ eyebrow | escape }}</span>{%- endif -%}
    <h1 id="PolicyHeroTitle-{{ section.id }}" class="s-h1{% if wide %} s-h1--wide s-balance{% endif %}">{{ headline | escape }}</h1>
    {%- if sub != blank -%}<p class="s-lead">{{ sub }}</p>{%- endif -%}
    {%- if meta != blank -%}<span class="s-phero__meta">{{ meta }}</span>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Policy banner",
  "class": "s-section-policy-hero",
  "settings": [
    {
      "type": "paragraph",
      "content": "Copy defaults per page handle: refund-policy, shipping-policy, privacy-policy, terms-of-service, payment-policy, contact-information, legal-notice, do-not-sell. Add a \"Page copy\" block to change it for one page. Tokens: {AppName}, {date} (page publish date), {minutes} (reading time)."
    },
    {
      "type": "page",
      "id": "parent_page",
      "label": "Breadcrumb parent page",
      "info": "Middle breadcrumb link. Defaults to the page with the handle support."
    },
    {
      "type": "text",
      "id": "parent_label",
      "label": "Breadcrumb parent label",
      "default": "Support"
    },
    {
      "type": "range",
      "id": "words_per_minute",
      "label": "Reading speed for {minutes}",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "wpm",
      "default": 200
    }
  ],
  "blocks": [
    {
      "type": "page_copy",
      "name": "Page copy",
      "settings": [
        {
          "type": "page",
          "id": "page",
          "label": "Page"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "textarea",
          "id": "subheadline",
          "label": "Subheadline"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Date line",
          "info": "For example: Effective March 1, 2026 · {minutes} min read"
        },
        {
          "type": "checkbox",
          "id": "hide_meta",
          "label": "Hide date line",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}
