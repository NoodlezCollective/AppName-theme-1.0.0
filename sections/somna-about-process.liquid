{%- comment -%}
  Design process steps (design: About.dc, "PROCESS"): numbered steps, each
  with a square photo (labelled placeholder until an image is picked).
{%- endcomment -%}
{{ 'somna-pages.css' | asset_url | stylesheet_tag }}
<section class="s-pg s-pg-sec s-aprocess">
  <div class="s-pg-stack40">
    <div class="s-pg-head">
      {%- if section.settings.eyebrow != blank -%}<span class="s-eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      <h2 class="s-h2">{% echo section.settings.heading | replace: '{AppName}', settings.brand_name | escape %}</h2>
    </div>
    <ol class="s-asteps">
      {%- for block in section.blocks -%}
        {%- assign step_label = 'Photo placeholder ' | append: block.settings.code -%}
        {%- assign step_alt = block.settings.image_alt | default: block.settings.title -%}
        <li class="s-astep" {{ block.shopify_attributes }}>
          {%- render 'somna-media',
            image: block.settings.image,
            alt: step_alt,
            code: block.settings.code,
            brief: block.settings.brief,
            label: step_label,
            icon: 'none',
            radius: 20,
            class: 's-astep__media',
            sizes: '(min-width: 1000px) 280px, (min-width: 600px) 50vw, 100vw'
          -%}
          <div class="s-astep__head">
            <span class="s-astep__n">{{ forloop.index }}</span>
            <h3 class="s-astep__title">{{ block.settings.title | escape }}</h3>
          </div>
          <p class="s-astep__body">{% echo block.settings.text | replace: '{AppName}', settings.brand_name | escape %}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Process steps",
  "class": "s-section-about-process",
  "settings": [
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How we design"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "From 3am Problem to Finished Product"}
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {"type": "image_picker", "id": "image", "label": "Image", "info": "Shown square."},
        {"type": "text", "id": "image_alt", "label": "Image alt text"},
        {"type": "text", "id": "code", "label": "Placeholder shot code", "default": "A-05"},
        {"type": "text", "id": "brief", "label": "Placeholder brief", "default": "Team reviewing customer notes and survey cards"},
        {"type": "text", "id": "title", "label": "Title", "default": "Listen"},
        {"type": "textarea", "id": "text", "label": "Text", "default": "We start with what keeps people up: heat, neck pain, partners who sleep differently."}
      ]
    }
  ],
  "presets": [
    {
      "name": "Process steps",
      "blocks": [
        {"type": "step", "settings": {"code": "A-05", "brief": "Team reviewing customer notes and survey cards", "title": "Listen", "text": "We start with what keeps people up: heat, neck pain, partners who sleep differently."}},
        {"type": "step", "settings": {"code": "A-06", "brief": "Pillow prototypes lined up on a workbench", "title": "Prototype", "text": "We test fills, fabrics and shapes, then test them again."}},
        {"type": "step", "settings": {"code": "A-07", "brief": "Tester in their own bedroom, candid", "title": "Sleep Test", "text": "Real sleepers take samples home and tell us the truth."}},
        {"type": "step", "settings": {"code": "A-08", "brief": "Hands finishing a seam, close-up", "title": "Refine", "text": "Only the version that wins the most nights becomes a {AppName} product."}}
      ]
    }
  ]
}
{% endschema %}
