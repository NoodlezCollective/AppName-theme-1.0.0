{%- comment -%}
  Closing lavender card (design: About.dc, "CTA"): heading, line and two
  buttons. The second button defaults to the Support page.
{%- endcomment -%}
{{ 'somna-pages.css' | asset_url | stylesheet_tag }}
<section class="s-pg s-acta">
  <div class="s-acta__card">
    <h2 class="s-h2">{{ section.settings.heading | replace: '{AppName}', settings.brand_name | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="s-acta__sub">{{ section.settings.text | replace: '{AppName}', settings.brand_name | escape }}</p>{%- endif -%}
    <div class="s-acta__btns">
      {%- if section.settings.primary_label != blank -%}
        <a class="s-btn s-btn--lg" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">{{ section.settings.primary_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="s-btn s-btn--lg s-btn--white" href="{% if section.settings.secondary_link != blank %}{{ section.settings.secondary_link }}{% else %}{% render 'somna-policy-url', handle: 'support' %}{% endif %}">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Closing call to action",
  "class": "s-section-about-cta",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "Come Sleep With Us"},
    {"type": "text", "id": "text", "label": "Text", "default": "Try anything for [100] nights. Love it, or send it back."},
    {"type": "text", "id": "primary_label", "label": "First button", "default": "Shop Now"},
    {"type": "url", "id": "primary_link", "label": "First button link", "default": "/collections/all"},
    {"type": "text", "id": "secondary_label", "label": "Second button", "default": "Talk to Our Team"},
    {"type": "url", "id": "secondary_link", "label": "Second button link", "info": "Defaults to the Support page (handle support)."}
  ],
  "presets": [{"name": "Closing call to action"}]
}
{% endschema %}
