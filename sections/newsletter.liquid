{%- comment -%}
  Newsletter band (app/components/home/NewsletterBand.tsx + NewsletterForm.tsx).
  The storefront posted to its own /newsletter endpoint; here the Shopify
  customer form subscribes the address (contact[tags]=newsletter) with the
  same classes, labels, placeholder and button text. Shopify answers with a
  full page load, so the status region is filled server side.
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name
  assign heading = section.settings.heading | replace: '{AppName}', brand
  assign body = section.settings.body | replace: '{AppName}', brand
  assign placeholder = section.settings.placeholder | replace: '{AppName}', brand
  assign cta_label = section.settings.cta_label | replace: '{AppName}', brand
  assign success_message = section.settings.success_message | replace: '{AppName}', brand
  assign form_id = 'newsletter-' | append: section.id
  assign input_id = form_id | append: '-email'
  assign status_id = form_id | append: '-status'
-%}
<section class="section section--tight" aria-labelledby="newsletter-heading">
  <div class="container">
    <div class="newsletter-band">
      <div>
        <h2 id="newsletter-heading">{{ heading }}</h2>
        <p class="newsletter-band__body">{{ body }}</p>
      </div>
      {%- form 'customer', class: 'newsletter-form', id: form_id -%}
        <label for="{{ input_id }}" class="sr-only">Email address</label>
        <div class="newsletter-form__row">
          <input id="{{ input_id }}" type="email" name="contact[email]" required placeholder="{{ placeholder | escape }}" autocomplete="email"{% if form.posted_successfully? or form.errors %} aria-describedby="{{ status_id }}"{% endif %}{% if form.errors %} aria-invalid="true"{% endif %}>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" value="">
          <input type="hidden" name="source" value="homepage">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <button class="btn btn--primary btn--md" type="submit"><span class="btn__label">{{ cta_label }}</span></button>
        </div>
        <div id="{{ status_id }}" class="newsletter-form__status" role="status">
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success">{{ success_message }}</p>
          {%- elsif form.errors -%}
            <p class="form-message form-message--error">
              {%- for field in form.errors -%}
                {%- if field == 'form' -%}
                  {{ form.errors.messages[field] }}
                {%- else -%}
                  {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                {%- endif -%}
                {%- unless forloop.last %} {% endunless -%}
              {%- endfor -%}
            </p>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sleep Smarter. Save More."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Join the {AppName} list for early access to launches, bundle savings and sleep tips."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Sign Up"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're on the list. Welcome to {AppName}."
    }
  ],
  "presets": [{"name": "Newsletter"}]
}
{% endschema %}
