{%- comment -%}
  Somna free-gift banner (design: Main / FREE GIFT). The progress bar reflects
  the live cart against the "Free gift threshold" theme setting: rendered by
  Liquid on load, then kept current by assets/somna-home.js on
  theme:cart:updated. Tokens: {threshold}, {remaining}, {gift}, {AppName}.
{%- endcomment -%}
{{ 'somna-home.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign brand = settings.brand_name
  assign threshold = settings.free_gift_threshold | default: 0 | times: 100 | round
  assign gift = settings.free_gift_label | replace: '{AppName}', brand
  assign total = cart.total_price | default: 0
  assign remaining = threshold | minus: total | at_least: 0
  assign pct = 0
  if threshold > 0
    assign pct = total | times: 100.0 | divided_by: threshold | at_most: 100 | round: 1
  endif
  assign threshold_money = threshold | money_without_trailing_zeros
  assign remaining_money = remaining | money

  assign heading = section.settings.heading | replace: '{AppName}', brand | replace: '{threshold}', threshold_money | replace: '{gift}', gift
  assign body = section.settings.body | replace: '{AppName}', brand | replace: '{threshold}', threshold_money | replace: '{gift}', gift
  assign progress_text = section.settings.progress_text | replace: '{AppName}', brand | replace: '{gift}', gift
  assign unlocked_text = section.settings.unlocked_text | replace: '{AppName}', brand | replace: '{gift}', gift
  assign button_label = section.settings.button_label | replace: '{AppName}', brand
  assign button_url = section.settings.button_url | default: routes.all_products_collection_url
  if remaining > 0
    assign status = progress_text | replace: '{remaining}', remaining_money
  else
    assign status = unlocked_text
  endif
-%}
<section class="sh sh-gift" aria-labelledby="SomnaGiftTitle-{{ section.id }}">
  <div class="sh-inner sh-gift__inner"
    data-sh-gift
    data-threshold="{{ threshold }}"
    data-progress-text="{{ progress_text | escape }}"
    data-unlocked-text="{{ unlocked_text | escape }}">
    <div class="sh-gift__icon">{%- render 'somna-icon', name: 'gift', size: 34 -%}</div>
    <div class="sh-gift__text">
      <h2 id="SomnaGiftTitle-{{ section.id }}" class="sh-gift__title">{{ heading }}</h2>
      {%- if body != blank -%}<p>{{ body }}</p>{%- endif -%}
    </div>
    {%- if threshold > 0 -%}
      <div class="sh-gift__progress">
        <div class="sh-gift__track" role="progressbar" aria-label="{{ 'Progress towards ' | append: gift | escape }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct | round }}" data-sh-gift-bar>
          <div class="sh-gift__fill" style="width: {{ pct }}%;" data-sh-gift-fill></div>
        </div>
        <span class="sh-gift__status" aria-live="polite" data-sh-gift-status>{{ status }}</span>
      </div>
    {%- endif -%}
    {%- if button_label != blank -%}<a class="s-btn" href="{{ button_url }}">{{ button_label }}</a>{%- endif -%}
  </div>
</section>
<script src="{{ 'somna-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Somna free gift",
  "settings": [
    {"type": "paragraph", "content": "The threshold and gift come from Theme settings > Cart reward. Tokens: {threshold}, {remaining}, {gift}."},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Spend {threshold}, Get a Free Silk Sleep Mask"},
    {"type": "textarea", "id": "body", "label": "Text", "default": "Added to your cart automatically when you reach the threshold. No code needed."},
    {"type": "text", "id": "progress_text", "label": "Progress message", "default": "You're {remaining} away from {gift}"},
    {"type": "text", "id": "unlocked_text", "label": "Unlocked message", "default": "You've unlocked {gift}!"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now"},
    {"type": "url", "id": "button_url", "label": "Button link", "default": "/collections/all"}
  ],
  "presets": [{"name": "Somna free gift"}]
}
{% endschema %}
